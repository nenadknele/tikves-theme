{% comment %}
  TIKVES LONDON · THE CHRISTMAS SIX PAGE · 3 Nov 2026
  REF · HORMOZI OFFER IN FULL v4, 10% on his word of 3 Nov.
  How it works, then the three ready-made sixes, then a pointer down to the
  eleven wines. Each six adds its bottles to the basket in one tap and goes
  to the cart. Prices are read live from the bottles: the six is the sum of
  its bottles, the 10% comes off at checkout. No was/now price is printed.
  "Only N left" shows for a bottle in a six at 60 or fewer, live count.
{% endcomment %}
{%- liquid
  assign six_index = 0
-%}
<style>
  .tl-sp{padding:36px 0 8px}
  .tl-sp__intro{max-width:640px;margin:0 auto 28px;text-align:center}
  .tl-sp__intro h2{margin:0 0 10px}
  .tl-sp__intro p{margin:0 0 6px}
  .tl-sp__steps{list-style:none;margin:0 auto 40px;padding:0;max-width:960px;display:grid;grid-template-columns:1fr;gap:12px;counter-reset:tlsp}
  .tl-sp__steps li{counter-increment:tlsp;display:flex;gap:12px;align-items:flex-start;padding:14px 16px;border:1px solid rgba(0,0,0,.12);border-radius:4px;font-size:15px;line-height:1.45}
  .tl-sp__steps li::before{content:counter(tlsp);flex:0 0 28px;height:28px;border-radius:50%;border:1px solid currentColor;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:600}
  .tl-sp__head{text-align:center;margin:0 auto 18px;max-width:640px}
  .tl-sp__head h2{margin:0 0 8px}
  .tl-sp__head p{margin:0}
  .tl-sp__grid{display:grid;grid-template-columns:1fr;gap:20px;max-width:1100px;margin:0 auto}
  .tl-sp__card{display:flex;flex-direction:column;border:1px solid rgba(0,0,0,.12);border-radius:4px;overflow:hidden}
  .tl-sp__thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;background:rgba(0,0,0,.04)}
  .tl-sp__thumbs img{display:block;width:100%;aspect-ratio:3/4;object-fit:cover}
  .tl-sp__body{padding:16px 16px 18px;display:flex;flex-direction:column;flex:1}
  .tl-sp__body h3{margin:0 0 8px}
  .tl-sp__body p{margin:0 0 8px;font-size:15px;line-height:1.45}
  .tl-sp__price{font-weight:600}
  .tl-sp__left{font-size:14px}
  .tl-sp__btn{margin-top:auto;width:100%}
  .tl-sp__body .tl-sp__btn{margin-top:12px}
  .tl-sp__more{text-align:center;margin:32px auto 0;max-width:640px}
  .tl-sp__more h2{margin:0 0 8px}
  .tl-sp__more p{margin:0}
  @media (min-width:769px){
    .tl-sp{padding:56px 0 16px}
    .tl-sp__steps{grid-template-columns:repeat(3,1fr);gap:16px}
    .tl-sp__grid{grid-template-columns:repeat(3,1fr);gap:24px}
  }
</style>

<div class="page-width tl-sp" id="tl-sixes">
  <div class="tl-sp__intro">
    <h2>{{ section.settings.how_heading | escape }}</h2>
  </div>
  <ol class="tl-sp__steps">
    <li>Pick any six bottles of the eleven Christmas Six wines. Mix them however you like.</li>
    <li>10% comes off at checkout. No code to remember.</li>
    <li>Delivery to England, Scotland and Wales is free. Order by Wednesday 16 December for Christmas delivery.</li>
  </ol>

  <div class="tl-sp__head">
    <h2>{{ section.settings.sixes_heading | escape }}</h2>
    {%- if section.settings.sixes_text != blank -%}<p>{{ section.settings.sixes_text | escape }}</p>{%- endif -%}
  </div>

  <div class="tl-sp__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign total = 0
        assign units = 0
        assign all_ok = true
        assign items = ''
        assign fallback = ''
        assign left_lines = ''
        assign kinds = 0
      -%}
      {%- capture thumbs -%}
        {%- for i in (1..6) -%}
          {%- liquid
            assign pkey = 'product_' | append: i
            assign qkey = 'qty_' | append: i
            assign p = block.settings[pkey]
            assign q = block.settings[qkey] | default: 0
          -%}
          {%- if p != blank and q > 0 -%}
            {%- liquid
              assign v = p.selected_or_first_available_variant
              assign line_total = v.price | times: q
              assign total = total | plus: line_total
              assign units = units | plus: q
              assign kinds = kinds | plus: 1
              unless v.available
                assign all_ok = false
              endunless
              if items != ''
                assign items = items | append: ','
                assign fallback = fallback | append: '&'
              endif
              assign items = items | append: '{"id":' | append: v.id | append: ',"quantity":' | append: q | append: '}'
              assign fallback = fallback | append: 'updates%5B' | append: v.id | append: '%5D=' | append: q
              if v.inventory_management != blank and v.inventory_quantity > 0 and v.inventory_quantity <= 60
                assign left_lines = left_lines | append: p.title | append: ': only ' | append: v.inventory_quantity | append: ' left. '
              endif
            -%}
            {%- if p.featured_image -%}
              {{ p.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200,300,400', sizes: '(min-width: 769px) 120px, 25vw', alt: p.title }}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if units > 0 -%}
        <div class="tl-sp__card" {{ block.shopify_attributes }}>
          <div class="tl-sp__thumbs" style="grid-template-columns:repeat({{ kinds }},1fr)">{{ thumbs }}</div>
          <div class="tl-sp__body">
            <h3>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
            <p class="tl-sp__price">{{ units }} bottles, {{ total | money }}. 10% comes off at checkout, delivered free in Great Britain.</p>
            {%- if left_lines != '' -%}<p class="tl-sp__left">{{ left_lines | strip | escape }}</p>{%- endif -%}
            {%- if all_ok -%}
              <a class="btn tl-sp__btn" href="/cart/update?{{ fallback }}" data-tl-six-add='[{{ items }}]'>{{ block.settings.button | default: 'Put It In Your Basket' | escape }}</a>
            {%- else -%}
              <p><strong>One of these bottles has sold out.</strong> Pick your own six below.</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="tl-sp__more">
    <h2>{{ section.settings.more_heading | escape }}</h2>
    <p>{{ section.settings.more_text | escape }}</p>
  </div>
</div>

<script>
(function () {
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('[data-tl-six-add]');
    if (!a) return;
    var items;
    try { items = JSON.parse(a.getAttribute('data-tl-six-add')); } catch (err) { return; }
    e.preventDefault();
    a.setAttribute('aria-busy', 'true');
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: items })
    }).then(function (r) {
      window.location.href = r.ok ? '/cart' : a.getAttribute('href');
    }).catch(function () {
      window.location.href = a.getAttribute('href');
    });
  });
})();
</script>

{% schema %}
{
  "name": "Christmas Six page",
  "settings": [
    { "type": "text", "id": "how_heading", "label": "How it works heading", "default": "How The Christmas Six Works" },
    { "type": "text", "id": "sixes_heading", "label": "Ready-made sixes heading", "default": "Start From One Of Ours" },
    { "type": "text", "id": "sixes_text", "label": "Ready-made sixes line", "default": "Each has two wines we only have a few of, and four we keep plenty of." },
    { "type": "text", "id": "more_heading", "label": "Bottom heading", "default": "Or Pick Your Own Six" },
    { "type": "text", "id": "more_text", "label": "Bottom line", "default": "All eleven wines are below. Add any six and the 10% comes off at checkout." }
  ],
  "blocks": [
    {
      "type": "six",
      "name": "Ready-made six",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Name", "default": "The Red Six" },
        { "type": "textarea", "id": "text", "label": "What is in it" },
        { "type": "text", "id": "button", "label": "Button", "default": "Put It In Your Basket" },
        { "type": "product", "id": "product_1", "label": "Bottle 1" },
        { "type": "range", "id": "qty_1", "label": "How many", "min": 0, "max": 6, "step": 1, "default": 1 },
        { "type": "product", "id": "product_2", "label": "Bottle 2" },
        { "type": "range", "id": "qty_2", "label": "How many", "min": 0, "max": 6, "step": 1, "default": 1 },
        { "type": "product", "id": "product_3", "label": "Bottle 3" },
        { "type": "range", "id": "qty_3", "label": "How many", "min": 0, "max": 6, "step": 1, "default": 2 },
        { "type": "product", "id": "product_4", "label": "Bottle 4" },
        { "type": "range", "id": "qty_4", "label": "How many", "min": 0, "max": 6, "step": 1, "default": 2 },
        { "type": "product", "id": "product_5", "label": "Bottle 5" },
        { "type": "range", "id": "qty_5", "label": "How many", "min": 0, "max": 6, "step": 1, "default": 0 },
        { "type": "product", "id": "product_6", "label": "Bottle 6" },
        { "type": "range", "id": "qty_6", "label": "How many", "min": 0, "max": 6, "step": 1, "default": 0 }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer", "custom.popups"] }
}
{% endschema %}
