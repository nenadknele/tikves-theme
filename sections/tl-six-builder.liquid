{% comment %}
  TIKVES LONDON · BUILD YOUR CHRISTMAS MIX · 3 Nov 2026
  The case builder for the Christmas Mix page, after the Zipify Bundle Builder
  that overtone.co and boombeauty.com run, built in the theme so there is no
  app fee. Single bottles only. Tabs filter Reds, Whites and Rosé. Every wine
  gets "Add To Your Mix"; a bar fills towards the steps, as Overtone does
  them (2 bottles 5%, 4 or more 10%, free delivery from 6); one button puts the lot in
  the basket and opens the cart.
  The discounts are Shopify automatic discounts, one per step, on the scope
  collection "Offer scope · The Christmas Mix". Shopify applies the best one.
  Nothing here sets a price. If a step changes in Shopify, change the marks
  and messages in this file, the hero boxes in the template, and the lines in
  tl-christmas-six, tl-urgency, product.wine and Find Your Wine in one pass.
  Desktop: the tray sits beside the grid and follows the scroll.
  Phone: a compact bar fixed to the bottom of the screen. It slides up once
  the wines are on screen or a bottle is in. Like Overtone, it carries no
  sentences: the count, the bar with its marks, and the button. While
  it's up, the chat and accessibility buttons lift above it (tikves-site-css).
{% endcomment %}
<style>
  .tl-sb{padding-top:0;padding-bottom:150px}
  .tl-sb__tabs{position:sticky;top:var(--tl-sb-top,0px);z-index:3;background:var(--colorBody,#f6efe8);display:flex;gap:8px;justify-content:center;padding:14px 0;margin:0 0 6px;overflow-x:auto;-webkit-overflow-scrolling:touch}
  .tl-sb__tab{flex:0 0 auto;border:1px solid currentColor;border-radius:999px;background:none;color:inherit;padding:9px 18px;font-size:13px;letter-spacing:.1em;text-transform:uppercase;font-weight:600;cursor:pointer;min-height:40px}
  .tl-sb__tab[aria-pressed="true"]{background:#2b1a14;border-color:#2b1a14;color:#fff}
  .tl-sb__how{list-style:none;margin:0 auto 18px;padding:0;max-width:960px;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;counter-reset:tlhow}
  .tl-sb__how li{counter-increment:tlhow;font-size:13px;line-height:1.35;text-align:center;padding:10px 6px;border:1px solid rgba(0,0,0,.12);border-radius:4px}
  .tl-sb__how li::before{content:counter(tlhow);display:flex;margin:0 auto 6px;width:24px;height:24px;border-radius:50%;border:1px solid currentColor;align-items:center;justify-content:center;font-size:12px;font-weight:600}
  .tl-sb__wrap{display:block}
  .tl-sb__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
  .tl-sb__card{display:flex;flex-direction:column;border:1px solid rgba(0,0,0,.12);border-radius:4px;overflow:hidden}
  .tl-sb__card[hidden]{display:none}
  .tl-sb__img{display:block;background:rgba(0,0,0,.03)}
  .tl-sb__img img{display:block;width:100%;aspect-ratio:3/4;object-fit:cover}
  .tl-sb__body{padding:10px 10px 12px;display:flex;flex-direction:column;flex:1;gap:4px}
  .tl-sb__title{font-size:15px;line-height:1.3;margin:0}
  .tl-sb__title a{color:inherit;text-decoration:none}
  .tl-sb__price{font-size:14px;margin:0}
  .tl-sb__price .is-off{color:#1f7a3a;font-weight:700}
  .tl-sb__price s{opacity:.6;margin-left:6px}
  .tl-sb__left{font-size:13px;margin:0;font-weight:600}
  .tl-sb__ctrl{margin-top:auto;padding-top:8px}
  .tl-sb__add{width:100%;padding-left:6px;padding-right:6px;letter-spacing:.08em;white-space:nowrap;background:#1f2328!important;border-color:#1f2328!important;color:#fff!important}
  .tl-sb__step{display:none;align-items:center;justify-content:space-between;border:1px solid currentColor;border-radius:999px;height:40px}
  .tl-sb__step button{background:none;border:0;width:44px;height:40px;font-size:20px;cursor:pointer;color:inherit}
  .tl-sb__step span{font-weight:600}
  .tl-sb__card.is-in .tl-sb__add{display:none}
  .tl-sb__card.is-in .tl-sb__step{display:flex}

  .tl-sb__tray{position:fixed;left:0;right:0;bottom:0;z-index:20;background:var(--colorBody,#f6efe8);border-top:1px solid rgba(0,0,0,.15);padding:10px 16px calc(10px + env(safe-area-inset-bottom));box-shadow:0 -4px 16px rgba(0,0,0,.08);transform:translateY(110%);transition:transform .3s ease;visibility:hidden}
  .tl-sb__tray.is-up{transform:none;visibility:visible}
  .tl-sb__trayhead{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin:0 0 4px}
  .tl-sb__trayhead h3{margin:0;font-size:16px}
  .tl-sb__count{font-weight:600;font-size:15px}
  .tl-sb__slots{display:none}
  .tl-sb__track{position:relative;height:6px;background:rgba(0,0,0,.1);border-radius:6px;margin:14px 14px 30px}
  .tl-sb__track i{position:absolute;left:0;top:0;bottom:0;width:0;background:#2b1a14;border-radius:6px;transition:width .25s}
  .tl-sb__mark{position:absolute;top:50%;transform:translate(-50%,-50%);text-align:center}
  .tl-sb__mark b{display:flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;background:#efe6dc;border:1px solid rgba(0,0,0,.15);font-size:12px}
  .tl-sb__mark span em{font-style:normal}
  .tl-sb__mark span{position:absolute;top:38px;left:50%;transform:translateX(-50%);white-space:nowrap;font-size:11px;opacity:.75}
  .tl-sb__mark--ship b{font-size:10px}
  .tl-sb__mark--ship span{left:auto;right:-14px;transform:none}
  .tl-sb__mark.is-on b{background:#2b1a14;border-color:#2b1a14;color:#fff}
  .tl-sb__msg{font-size:13px;line-height:1.35;margin:0 0 10px}
  .tl-sb__row{display:flex;gap:12px;align-items:center}
  .tl-sb__go{flex:1;display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;background:#1f2328!important;border:1.5px solid #1f2328!important;color:#fff!important;opacity:1!important;min-height:42px;padding:9px 16px!important;font-size:12px!important;letter-spacing:.12em!important;transition:background-color .25s,color .25s}
  .tl-sb__go.is-empty{background:#c9c2bb!important;border-color:#c9c2bb!important;color:#fff!important}
  .tl-sb__go[aria-busy="true"]{opacity:.8!important}
  .tl-sb__total{letter-spacing:0;text-transform:none;font-weight:700}
  .tl-sb__total .is-off{color:#6fdc8c}
  .tl-sb__total s{opacity:.7;margin-left:6px;font-weight:400}
  .tl-sb__clear[hidden]{display:none}
  .tl-sb__clear{background:none;border:0;text-decoration:underline;text-underline-offset:3px;font-size:13px;cursor:pointer;color:inherit;padding:0}

  /* Hero tier boxes. The list lives in the countdown section's text on this
     template; this section is only on this page, so the style rides here. */
  .countdown__richtext ul{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:18px auto 6px;padding:0;max-width:520px}
  .countdown__richtext ul li{display:flex;flex-direction:column;align-items:center;justify-content:center;margin:0;padding:10px 4px 9px;border:1.5px solid #fff;border-radius:2px;background:rgba(20,12,8,.45);text-align:center;font-size:10px;line-height:1.2;letter-spacing:.14em;text-transform:uppercase;font-weight:600}
  .countdown__richtext ul li::before{content:none}
  .countdown__richtext ul li strong{display:block;font-size:30px;line-height:1;letter-spacing:0;text-transform:none;margin:5px 0 4px;font-weight:700}
  .countdown__richtext p:empty{display:none}
  @media (min-width:769px){
    .countdown__richtext ul{gap:14px;max-width:600px}
    .countdown__richtext ul li{padding:14px 10px 12px;font-size:12px}
    .countdown__richtext ul li strong{font-size:40px}
  }

  @media (max-width:768px){
    .tl-sb{padding-left:16px;padding-right:16px}
    .tl-sb__tabs{margin-left:-16px;margin-right:-16px;padding-left:16px;padding-right:16px;justify-content:flex-start}
    .tl-sb__msg,.tl-sb__clear{display:none!important}
    .tl-sb__track{margin:14px 16px 44px}
    .tl-sb__mark--ship span{right:-6px}
    .tl-sb__mark b{width:30px;height:30px;font-size:11px}
    .tl-sb__mark span{top:33px}
  }
  @media (min-width:769px){
    .tl-sb{padding-bottom:56px}
    .tl-sb__mark span em{display:none}
    .tl-sb__track{margin:16px 18px 30px}
    .tl-sb__tabs{gap:12px;padding:18px 0}
    .tl-sb__how{gap:16px;margin-bottom:24px}
    .tl-sb__how li{font-size:14px;padding:14px}
    .tl-sb__wrap{display:grid;grid-template-columns:1fr 340px;gap:28px;align-items:start}
    .tl-sb__grid{grid-template-columns:repeat(3,1fr);gap:18px}
    .tl-sb__tray{position:sticky;top:calc(var(--tl-sb-top,0px) + 90px);left:auto;right:auto;bottom:auto;z-index:2;border:1px solid rgba(0,0,0,.15);border-radius:4px;padding:18px;box-shadow:none;transform:none;visibility:visible}
    .tl-sb__trayhead h3{font-size:20px}
    .tl-sb__slots{display:grid;grid-template-columns:repeat(6,1fr);gap:6px;margin:12px 0 4px}
    .tl-sb__slot{aspect-ratio:3/4;border:1px dashed rgba(0,0,0,.3);border-radius:4px;overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:11px;opacity:.8}
    .tl-sb__slot img{width:100%;height:100%;object-fit:contain;background:#fff}
    .tl-sb__slot.is-full{border-style:solid;opacity:1}
    .tl-sb__row{flex-direction:column;align-items:stretch}
  }
</style>

{%- comment -%} Count the kinds so a tab only shows when it has wines. {%- endcomment -%}
{%- liquid
  assign reds = 0
  assign whites = 0
  assign roses = 0
  for p in collection.products limit: 24
    if p.tags contains 'type:red'
      assign reds = reds | plus: 1
    elsif p.tags contains 'type:white'
      assign whites = whites | plus: 1
    elsif p.tags contains 'type:rose'
      assign roses = roses | plus: 1
    endif
  endfor
-%}
<div class="page-width tl-sb" id="tl-build" data-tl-sb>
  <div class="tl-sb__tabs" role="group" aria-label="Show wines">
    <button type="button" class="tl-sb__tab" data-tl-sb-tab="all" aria-pressed="true">All</button>
    {%- if reds > 0 -%}<button type="button" class="tl-sb__tab" data-tl-sb-tab="red" aria-pressed="false">Reds</button>{%- endif -%}
    {%- if whites > 0 -%}<button type="button" class="tl-sb__tab" data-tl-sb-tab="white" aria-pressed="false">Whites</button>{%- endif -%}
    {%- if roses > 0 -%}<button type="button" class="tl-sb__tab" data-tl-sb-tab="rose" aria-pressed="false">Rosé</button>{%- endif -%}
  </div>

  <ol class="tl-sb__how">
    <li>Tap Add on any bottles. Mix them however you like.</li>
    <li>The more you add, the more comes off. No code.</li>
    <li>Put your mix in the basket in one tap.</li>
  </ol>

  <div class="tl-sb__wrap">
    <div class="tl-sb__grid">
      {%- for p in collection.products limit: 24 -%}
        {%- liquid
          assign v = p.selected_or_first_available_variant
          assign max = 99
          if v.inventory_management != blank and v.inventory_policy == 'deny'
            assign max = v.inventory_quantity
          endif
          assign kind = 'other'
          if p.tags contains 'type:red'
            assign kind = 'red'
          elsif p.tags contains 'type:white'
            assign kind = 'white'
          elsif p.tags contains 'type:rose'
            assign kind = 'rose'
          endif
        -%}
        <div class="tl-sb__card" data-tl-sb-card data-kind="{{ kind }}" data-id="{{ v.id }}" data-price="{{ v.price }}" data-max="{{ max }}" data-title="{{ p.title | escape }}" data-img="{{ p.featured_image | image_url: width: 160 }}">
          <a class="tl-sb__img" href="{{ p.url }}">
            {%- if p.featured_image -%}
              {{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,300,400,600', sizes: '(min-width: 769px) 240px, 50vw', alt: p.title }}
            {%- endif -%}
          </a>
          <div class="tl-sb__body">
            <p class="tl-sb__title"><a href="{{ p.url }}">{{ p.title }}</a></p>
            <p class="tl-sb__price" data-tl-sb-price>{{ v.price | money }}</p>
            {%- if v.available and v.inventory_management != blank and v.inventory_quantity <= 60 -%}
              <p class="tl-sb__left">Only {{ v.inventory_quantity }} left.</p>
            {%- endif -%}
            <div class="tl-sb__ctrl">
              {%- if v.available -%}
                <button type="button" class="btn btn--small tl-sb__add" data-tl-sb-add>Add To Your Mix</button>
                <div class="tl-sb__step" aria-live="polite">
                  <button type="button" data-tl-sb-minus aria-label="One fewer {{ p.title | escape }}">&minus;</button>
                  <span data-tl-sb-qty>0</span>
                  <button type="button" data-tl-sb-plus aria-label="One more {{ p.title | escape }}">+</button>
                </div>
              {%- else -%}
                <p class="tl-sb__left">Sold out for now.</p>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <aside class="tl-sb__tray" aria-label="Your mix">
      <div class="tl-sb__trayhead">
        <h3>Your Mix</h3>
        <span class="tl-sb__count" data-tl-sb-count>0 bottles</span>
      </div>
      <div class="tl-sb__slots" data-tl-sb-slots></div>
      <div class="tl-sb__track" aria-hidden="true">
        <i data-tl-sb-bar></i>
        <div class="tl-sb__mark" data-at="2" style="left:33.33%"><b>5%</b><span>2 bottles</span></div>
        <div class="tl-sb__mark" data-at="4" style="left:66.67%"><b>10%</b><span>4+ bottles</span></div>
        <div class="tl-sb__mark tl-sb__mark--ship" data-at="6" style="left:100%"><b>Free</b><span>6+ free delivery</span></div>
      </div>
      <p class="tl-sb__msg" data-tl-sb-msg aria-live="polite"></p>
      <div class="tl-sb__row">
        <button type="button" class="btn tl-sb__go is-empty" data-tl-sb-go><span>Add To Basket</span><span class="tl-sb__total" data-tl-sb-total></span></button>
        <button type="button" class="tl-sb__clear" data-tl-sb-clear hidden>Start again</button>
      </div>
    </aside>
  </div>
</div>

<script>
(function () {
  var root = document.querySelector('[data-tl-sb]');
  if (!root) return;
  var pick = {};   // variant id -> qty
  var order = [];  // variant ids in the order picked, one entry per bottle
  var cards = {};
  root.querySelectorAll('[data-tl-sb-card]').forEach(function (c) { cards[c.dataset.id] = c; });
  var slots = root.querySelector('[data-tl-sb-slots]');
  var bar = root.querySelector('[data-tl-sb-bar]');
  var marks = root.querySelectorAll('.tl-sb__mark');
  var count = root.querySelector('[data-tl-sb-count]');
  var msg = root.querySelector('[data-tl-sb-msg]');
  var go = root.querySelector('[data-tl-sb-go]');
  var clear = root.querySelector('[data-tl-sb-clear]');
  var tray = root.querySelector('.tl-sb__tray');
  var grid = root.querySelector('.tl-sb__grid');
  var tabs = root.querySelector('.tl-sb__tabs');

  // Keep the tabs under the sticky site header.
  function headerTop() {
    var h = document.querySelector('.site-header, #SiteHeader, [data-section-type="header"] .site-header');
    var top = 0;
    if (h) { var r = h.getBoundingClientRect(); if (r.top <= 1 && r.bottom > 0) top = Math.round(r.bottom); }
    root.style.setProperty('--tl-sb-top', top + 'px');
  }
  window.addEventListener('scroll', headerTop, { passive: true });
  window.addEventListener('resize', headerTop);
  headerTop();

  function total() { return order.length; }

  // Phone: the bar slides up once the wines are on screen or a bottle is in.
  var gridSeen = false;
  function lift() {
    var up = gridSeen || total() > 0;
    tray.classList.toggle('is-up', up);
    var phone = window.matchMedia('(max-width: 768px)').matches;
    document.documentElement.style.setProperty('--tl-tray-h', (up && phone ? tray.offsetHeight : 0) + 'px');
    document.documentElement.classList.toggle('tl-mix-tray-up', up && phone);
  }
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (es) {
      es.forEach(function (e) { gridSeen = e.isIntersecting; });
      lift();
    }, { rootMargin: '0px 0px -30% 0px' }).observe(grid);
  } else { gridSeen = true; }

  function bottles(n) { return n + (n === 1 ? ' bottle' : ' bottles'); }
  function money(p) { return '£' + (p / 100).toFixed(2); }
  var totalEl = root.querySelector('[data-tl-sb-total]');

  function render() {
    var n = total();
    // Desktop slots: six, then twelve once past six.
    var shown = n <= 6 ? 6 : 12;
    var html = '';
    for (var i = 0; i < shown; i++) {
      var id = order[i];
      if (id) {
        var c = cards[id];
        html += '<div class="tl-sb__slot is-full"><img src="' + c.dataset.img + '" alt="' + c.dataset.title + '"></div>';
      } else {
        html += '<div class="tl-sb__slot">' + (i + 1) + '</div>';
      }
    }
    slots.innerHTML = html;
    bar.style.width = Math.min(100, Math.round(n / 6 * 100)) + '%';
    marks.forEach(function (m) { m.classList.toggle('is-on', n >= +m.dataset.at); });
    count.textContent = bottles(n);
    if (n === 0) {
      msg.innerHTML = 'Two bottles get 5% off. Four or more get 10%. Six or more come with free delivery.';
    } else if (n < 2) {
      msg.innerHTML = '<strong>Add 1 more bottle for 5% off.</strong>';
    } else if (n < 4) {
      msg.innerHTML = '<strong>5% off is on.</strong> Add ' + bottles(4 - n) + ' more for 10% off.';
    } else if (n < 6) {
      msg.innerHTML = '<strong>10% off is on.</strong> Add ' + bottles(6 - n) + ' more for free delivery.';
    } else {
      msg.innerHTML = '<strong>10% off and free delivery are on.</strong>';
    }
    // Prices, like Overtone: once a step is reached, every bottle shows the
    // price after that step's discount in green with the full price struck
    // through, and the button shows the total. Rounded per line, the way
    // Shopify rounds a percentage discount.
    var pct = n >= 4 ? 10 : (n >= 2 ? 5 : 0);
    var full = 0, paid = 0;
    Object.keys(pick).forEach(function (id) {
      var line = (+cards[id].dataset.price || 0) * pick[id];
      full += line;
      paid += Math.round(line * (100 - pct) / 100);
    });
    Object.keys(cards).forEach(function (id) {
      var pe = cards[id].querySelector('[data-tl-sb-price]');
      var pr = +cards[id].dataset.price || 0;
      if (!pe) return;
      pe.innerHTML = pct
        ? '<span class="is-off">' + money(Math.round(pr * (100 - pct) / 100)) + '</span><s>' + money(pr) + '</s>'
        : money(pr);
    });
    go.classList.toggle('is-empty', n === 0);
    totalEl.innerHTML = n === 0 ? '' : (pct
      ? '<span class="is-off">' + money(paid) + '</span><s>' + money(full) + '</s>'
      : money(full));
    clear.hidden = n === 0;
    Object.keys(cards).forEach(function (id) {
      var q = pick[id] || 0;
      cards[id].classList.toggle('is-in', q > 0);
      var qe = cards[id].querySelector('[data-tl-sb-qty]');
      if (qe) qe.textContent = q;
    });
    lift();
  }

  function add(id) {
    var c = cards[id];
    var max = parseInt(c.dataset.max, 10) || 99;
    if ((pick[id] || 0) >= max) return;
    pick[id] = (pick[id] || 0) + 1;
    order.push(id);
    render();
  }
  function remove(id) {
    if (!pick[id]) return;
    pick[id]--;
    var at = order.lastIndexOf(id);
    if (at > -1) order.splice(at, 1);
    if (!pick[id]) delete pick[id];
    render();
  }

  tabs.addEventListener('click', function (e) {
    var t = e.target.closest('[data-tl-sb-tab]');
    if (!t) return;
    var kind = t.dataset.tlSbTab;
    tabs.querySelectorAll('[data-tl-sb-tab]').forEach(function (b) { b.setAttribute('aria-pressed', b === t ? 'true' : 'false'); });
    Object.keys(cards).forEach(function (id) {
      cards[id].hidden = !(kind === 'all' || cards[id].dataset.kind === kind);
    });
    var y = tabs.getBoundingClientRect().top + window.scrollY - (parseInt(getComputedStyle(root).getPropertyValue('--tl-sb-top'), 10) || 0);
    if (window.scrollY > y) window.scrollTo({ top: y, behavior: 'smooth' });
  });

  root.addEventListener('click', function (e) {
    var card = e.target.closest('[data-tl-sb-card]');
    if (!card) return;
    if (e.target.closest('[data-tl-sb-add]') || e.target.closest('[data-tl-sb-plus]')) { add(card.dataset.id); return; }
    if (e.target.closest('[data-tl-sb-minus]')) { remove(card.dataset.id); return; }
  });
  clear.addEventListener('click', function () { pick = {}; order = []; render(); });
  go.addEventListener('click', function () {
    var items = Object.keys(pick).map(function (id) { return { id: +id, quantity: pick[id] }; });
    if (!items.length) {
      var y = tabs.getBoundingClientRect().top + window.scrollY - 70;
      window.scrollTo({ top: y, behavior: 'smooth' });
      return;
    }
    go.disabled = true;
    go.setAttribute('aria-busy', 'true');
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: items })
    }).then(function (r) {
      if (r.ok) { window.location.href = '/cart'; return; }
      return r.json().then(function (j) {
        msg.innerHTML = (j && j.description) ? j.description : 'Something went wrong. Please try again.';
        go.disabled = false;
      });
    }).catch(function () {
      msg.innerHTML = 'Something went wrong. Please try again.';
      go.disabled = false;
    });
  });
  render();
})();
</script>

{% schema %}
{
  "name": "Build your Christmas Mix",
  "settings": [],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}
