{%- comment -%}
  Black Friday early bird · homepage band · 9 Nov 2026. From the design of
  9 November, board 1, "Black Friday early bird" (claude.ai artifact
  K5q1nLPkuQgpwScpqs4j23, project/Main.dc.html). Built in the theme's own
  code; the design file is the layout and the words, not pasted in.

  WHEN IT SHOWS
  · Only while the page it links to is published (page_handle, default
    early-bird). An unpublished page is not in the storefront's pages
    object, so before go-live the band renders nothing at all.
  · Only until the end of Monday 23 November UK. That date lives in
    snippets/tl-dates.liquid (TL.dates.ebBandEnd), nowhere else. The band
    is hidden by CSS unless tl-dates set html.tl-eb-band.
  · TEST COPIES ONLY: a homepage template whose suffix contains "ebtest"
    (index.ebtest.json, never in the repo) renders it before the page is
    published, so it can be checked on a copy. The clock still applies.

  WORDS, from the design, his word owed before publish. Never on it: a
  depth, an end date, a gift, a delivery line, £85, "VIP", "sale", "deal",
  "save", a countdown or a stock count.

  GRAPHIC: one bf26- graphic, picked in the template as
  shopify://shop_images/<name>, the same as the early bird page's, 9 Nov
  2026 on his yes. Phone: words, then the graphic. Desktop: graphic left,
  words right. Left empty, or not yet uploaded, the band is words only.
{%- endcomment -%}

{%- liquid
  assign eb_page = pages[section.settings.page_handle]
  assign eb_show = false
  if eb_page != blank and eb_page.url != blank
    assign eb_show = true
  endif
  assign eb_sfx = template.suffix | default: ''
  if eb_sfx contains 'ebtest'
    assign eb_show = true
  endif
  assign eb_link = section.settings.button_link | default: '/pages/early-bird'
-%}

{%- if eb_show -%}
  {%- render 'tl-eb-style' -%}
  <div class="tl-ebb tl-eb-x{% if section.settings.band_image != blank %} ebb--pic{% endif %}" data-tl-eb-band>
    <div class="ebb__panel">
      {%- if section.settings.kicker != blank -%}
        <p class="ebb__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- liquid
        assign htag = section.settings.heading_tag | default: 'h2'
      -%}
      <{{ htag }} class="eb-h ebb__head">{{ section.settings.heading }}{% if section.settings.heading_em != blank %} <span class="eb-em">{{ section.settings.heading_em }}</span>{% endif %}</{{ htag }}>
      {%- if section.settings.text != blank -%}
        <p class="ebb__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="eb-btn eb-btn--solid ebb__btn" href="{{ eb_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
    {%- if section.settings.band_image != blank -%}
      <a class="ebb__pic" href="{{ eb_link }}" tabindex="-1" aria-hidden="true">
        {{- section.settings.band_image | image_url: width: 1400 | image_tag: class: 'ebb__img', loading: 'lazy', widths: '400, 600, 800, 1000, 1400', sizes: '(min-width: 769px) 50vw, 100vw', alt: '' -}}
      </a>
    {%- endif -%}
  </div>
  {%- style -%}
    .ebb__panel { background: var(--eb-paper-deep); padding: 48px 24px 40px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px; }
    .ebb__kicker { margin: 0; font-size: 12px; line-height: 1.4; letter-spacing: 0.16em !important; text-transform: uppercase !important; color: var(--eb-wine); font-weight: 500; }
    .ebb__head { font-size: 40px; line-height: 1.1; color: var(--eb-ink); }
    .ebb__text { margin: 0; font-size: 17px; line-height: 1.6; max-width: 320px; }
    .ebb__btn { margin-top: 8px; }
    .ebb__pic { display: block; background: var(--eb-paper-deep); padding: 0 16px 16px; }
    .ebb__img { display: block; width: 100%; height: auto; max-height: 420px; object-fit: cover; }
    @media (min-width: 769px) {
      .ebb--pic { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); background: var(--eb-paper-deep); }
      html.tl-eb-band .ebb--pic { display: grid; }
      .ebb--pic .ebb__panel { order: 2; justify-content: center; }
      .ebb--pic .ebb__pic { order: 1; padding: 32px 0 32px 32px; }
      .ebb--pic .ebb__img { max-height: 560px; height: 100%; }
      .ebb__panel { padding: 72px 24px 64px; }
      .ebb__head { font-size: 56px; }
      .ebb__text { max-width: 520px; font-size: 18px; }
    }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "Early bird band",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "heading_tag", "label": "Heading level (h1 when this is the first section on the page)", "options": [{ "value": "h1", "label": "h1" }, { "value": "h2", "label": "h2" }], "default": "h2" },
    { "type": "paragraph", "content": "Shows only while the early bird page is published, and only until the end of Monday 23 November (snippets/tl-dates)." },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Black Friday" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop it" },
    { "type": "text", "id": "heading_em", "label": "Heading, italic end", "default": "first." },
    { "type": "textarea", "id": "text", "label": "Line", "default": "Join the early list and shop Black Friday a week before everyone else." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Get early access" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "page_handle", "label": "Page it waits for", "default": "early-bird" },
    { "type": "image_picker", "id": "band_image", "label": "Graphic" }
  ],
  "presets": [{ "name": "Early bird band" }]
}
{% endschema %}
