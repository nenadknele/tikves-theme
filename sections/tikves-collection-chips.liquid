{%- comment -%}
  Tikves London - Collection chips
  Navigation between collections, read from a navigation menu
  (collection-chips), so add, remove or reorder them under Navigation,
  never in code.

  Operator ruling 28 Oct 2026, second pass: shop by collection as a
  row of small drawn tiles, about six across a phone like Overtone,
  swiping for the rest. On a phone the row loops round like Overtone's:
  the tiles render three times, the outer copies hidden from screen
  readers and tab order, and the script keeps the view on the middle
  copy. On desktop the copies are hidden and the row stands still.
  A short label sits under each drawing. Placed on the homepage after the
  grapes section, where Overtone puts theirs. Dots under the row on
  mobile. On desktop all tiles sit in one row with no scrolling.
  Each tile shows its drawing from snippets/tikves-collection-art.liquid,
  keyed by collection handle and approved by the operator from a mockup.
  A collection with no drawing falls back to its collection image, or the
  first product's image. No text is ever drawn on a picture.
  The thin pills of earlier the same day stay available under Layout.
  5 Sep 2026: no hover colour change.
  6 Sep 2026: the current item marks in Ink, never Wine, so Terra Rossa
  keeps meaning buy.
{%- endcomment -%}

{%- liquid
  assign chip_menu = linklists[section.settings.menu]
  assign outline_alpha = section.settings.outline_strength | divided_by: 100.0
  assign outline_color = section.settings.outline_color | color_modify: 'alpha', outline_alpha
  assign chip_count = chip_menu.links.size
  assign active_bg = section.settings.active_bg | default: '#1F2328'
  assign active_text = section.settings.active_text | default: '#F6EEE8'
  assign layout = section.settings.layout | default: 'tiles'
-%}

{%- if chip_count > 0 -%}
<nav class="tk-chips page-width tk-chips--{{ layout }}" id="tk-chips-{{ section.id }}" aria-label="{{ section.settings.heading | default: 'Shop by collection' | escape }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="tk-chips__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if layout == 'tiles' -%}
    <ul class="tk-chips__rail" data-tk-rail>
      {%- for pass in (1..3) -%}
      {%- assign is_clone = true -%}
      {%- if pass == 2 -%}{%- assign is_clone = false -%}{%- endif -%}
      {%- for link in chip_menu.links -%}
        {%- liquid
          assign is_current = false
          if link.active
            assign is_current = true
          elsif collection and link.url == collection.url
            assign is_current = true
          endif
          assign tile_image = blank
          assign tile_art = ''
          if link.type == 'collection_link'
            capture tile_art
              render 'tikves-collection-art', handle: link.object.handle
            endcapture
            assign tile_art = tile_art | strip
            if tile_art == blank
              assign tile_image = link.object.featured_image
            endif
          endif
        -%}
        <li class="tk-chips__tile{% if is_clone %} tk-chips__tile--clone{% endif %}"{% if is_clone %} aria-hidden="true"{% else %} data-tk-real{% endif %}>
          <a href="{{ link.url }}"
             class="tk-tile{% if is_current %} is-current{% endif %}"
             {%- if is_clone %} tabindex="-1"{% elsif is_current %} aria-current="page"{% endif %}>
            <span class="tk-tile__media{% if tile_art != blank %} tk-tile__media--art{% endif %}">
              {%- if tile_art != blank -%}
                {{- tile_art -}}
              {%- elsif tile_image != blank -%}
                {{- tile_image | image_url: width: 480 | image_tag:
                  widths: '160, 240, 320, 480',
                  sizes: '(min-width: 769px) 16vw, 31vw',
                  loading: 'lazy',
                  alt: '',
                  class: 'tk-tile__img' -}}
              {%- endif -%}
            </span>
            <span class="tk-tile__label">{{ link.title | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
      {%- endfor -%}
    </ul>
    <div class="tk-chips__dots" data-tk-dots aria-hidden="true">
      {%- for link in chip_menu.links -%}
        <span class="tk-chips__dot{% if forloop.first %} is-on{% endif %}"></span>
      {%- endfor -%}
    </div>
  {%- else -%}
    <ul class="tk-chips__grid">
      {%- for link in chip_menu.links -%}
        {%- assign is_current = false -%}
        {%- if link.active -%}
          {%- assign is_current = true -%}
        {%- elsif collection and link.url == collection.url -%}
          {%- assign is_current = true -%}
        {%- endif -%}
        <li class="tk-chips__item">
          <a href="{{ link.url }}"
             class="tk-chips__chip{% if is_current %} is-current{% endif %}"
             {%- if is_current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</nav>

{%- style -%}
  #tk-chips-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #tk-chips-{{ section.id }} .tk-chips__heading {
    margin: 0 0 24px;
    font-weight: 400;
    font-size: 26px;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Tiles */
  #tk-chips-{{ section.id }} .tk-chips__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    gap: 14px;
    margin: 0 -17px;
    padding: 0 17px 4px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 17px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  #tk-chips-{{ section.id }} .tk-chips__rail::-webkit-scrollbar { display: none; }
  #tk-chips-{{ section.id }} .tk-chips__tile { margin: 0; scroll-snap-align: start; }
  #tk-chips-{{ section.id }}.is-static .tk-chips__tile--clone { display: none; }
  #tk-chips-{{ section.id }} a.tk-tile,
  #tk-chips-{{ section.id }} a.tk-tile:hover,
  #tk-chips-{{ section.id }} a.tk-tile:focus {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: #1F2328;
    text-decoration: none;
  }
  #tk-chips-{{ section.id }} .tk-tile__media {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    overflow: hidden;
    background-color: #F6EEE8;
  }
  #tk-chips-{{ section.id }} .tk-tile__media--art {
    width: 58px;
    aspect-ratio: auto;
    border-radius: 0;
    overflow: visible;
    background-color: transparent;
  }
  #tk-chips-{{ section.id }} .tk-tile__art {
    display: block;
    width: 100%;
    height: auto;
  }
  #tk-chips-{{ section.id }} .tk-tile__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #tk-chips-{{ section.id }} .tk-tile__label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    font-size: 11px;
    white-space: nowrap;
    line-height: 1.2;
    text-align: center;
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
  }
  #tk-chips-{{ section.id }} a.tk-tile.is-current .tk-tile__label {
    border-bottom-color: {{ active_bg }};
  }
  #tk-chips-{{ section.id }} a.tk-tile:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 12px;
  }
  #tk-chips-{{ section.id }} .tk-chips__dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
  }
  #tk-chips-{{ section.id }} .tk-chips__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1px solid #1F2328;
    background-color: transparent;
  }
  #tk-chips-{{ section.id }} .tk-chips__dot.is-on { background-color: #1F2328; }

  /* Pills */
  #tk-chips-{{ section.id }} .tk-chips__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #tk-chips-{{ section.id }} .tk-chips__item { margin: 0; }
  #tk-chips-{{ section.id }} .tk-chips__item:last-child:nth-child(odd) { grid-column: 1 / -1; }
  #tk-chips-{{ section.id }} ul.tk-chips__grid li.tk-chips__item a.tk-chips__chip,
  #tk-chips-{{ section.id }} ul.tk-chips__grid li.tk-chips__item a.tk-chips__chip:hover,
  #tk-chips-{{ section.id }} ul.tk-chips__grid li.tk-chips__item a.tk-chips__chip:focus {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid {{ outline_color }};
    border-radius: 999px;
    background-color: transparent;
    color: #1F2328;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 500;
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.2;
    text-align: center;
  }
  #tk-chips-{{ section.id }} ul.tk-chips__grid li.tk-chips__item a.tk-chips__chip.is-current,
  #tk-chips-{{ section.id }} ul.tk-chips__grid li.tk-chips__item a.tk-chips__chip.is-current:hover {
    background-color: {{ active_bg }};
    border-color: {{ active_bg }};
    color: {{ active_text }};
  }
  #tk-chips-{{ section.id }} .tk-chips__chip:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  @media (min-width: 769px) {
    #tk-chips-{{ section.id }} .tk-chips__heading { font-size: 32px; margin-bottom: 32px; }
    #tk-chips-{{ section.id }} .tk-tile__media--art { width: 100%; max-width: 132px; }
    #tk-chips-{{ section.id }} .tk-chips__rail {
      grid-auto-flow: row;
      grid-template-columns: repeat({{ chip_count }}, minmax(0, 1fr));
      grid-auto-columns: auto;
      gap: 20px;
      margin: 0;
      padding: 0;
      overflow: visible;
    }
    #tk-chips-{{ section.id }} .tk-tile__label {
      font-size: {{ section.settings.text_size_desktop }}px;
      letter-spacing: 0.12em;
    }
    #tk-chips-{{ section.id }} .tk-chips__dots { display: none; }
    #tk-chips-{{ section.id }} .tk-chips__tile--clone { display: none; }
    #tk-chips-{{ section.id }} .tk-chips__grid {
      grid-template-columns: repeat({{ chip_count }}, minmax(0, 1fr));
      gap: 14px;
      max-width: none;
      margin: 0;
    }
    #tk-chips-{{ section.id }} .tk-chips__item:last-child:nth-child(odd) { grid-column: auto; }
    #tk-chips-{{ section.id }} ul.tk-chips__grid li.tk-chips__item a.tk-chips__chip,
    #tk-chips-{{ section.id }} ul.tk-chips__grid li.tk-chips__item a.tk-chips__chip:hover {
      min-height: 48px;
      padding: 12px 12px;
      font-size: {{ section.settings.text_size_desktop }}px;
      letter-spacing: 0.12em;
      hyphens: none;
    }
  }
{%- endstyle -%}

{%- if layout == 'tiles' -%}
<script>
  (function () {
    var root = document.getElementById('tk-chips-{{ section.id }}');
    if (!root) return;
    var rail = root.querySelector('[data-tk-rail]');
    var dots = root.querySelectorAll('[data-tk-dots] .tk-chips__dot');
    var real = rail ? rail.querySelectorAll('[data-tk-real]') : [];
    if (!rail || !real.length) return;
    var mq = window.matchMedia('(max-width: 768px)');
    var n = real.length, setW = 0, step = 0, timer = null;

    function measure() {
      var first = rail.firstElementChild;
      setW = real[0].offsetLeft - first.offsetLeft;
      step = n > 1 ? (real[1].offsetLeft - real[0].offsetLeft) : setW;
    }
    function looping() {
      return mq.matches && setW > 0 && rail.scrollWidth > rail.clientWidth;
    }
    function jump(to) {
      var snap = rail.style.scrollSnapType;
      rail.style.scrollSnapType = 'none';
      rail.scrollLeft = to;
      window.requestAnimationFrame(function () { rail.style.scrollSnapType = snap; });
    }
    function setDots() {
      if (!dots.length) return;
      var tiles = rail.children, base = tiles[0].offsetLeft, best = 0, bd = Infinity;
      for (var k = 0; k < tiles.length; k++) {
        if (tiles[k].offsetParent === null) continue;
        var dist = Math.abs(tiles[k].offsetLeft - base - rail.scrollLeft);
        if (dist < bd) { bd = dist; best = k; }
      }
      var i = mq.matches ? best % n : Math.max(0, best - n);
      for (var d = 0; d < dots.length; d++) dots[d].classList.toggle('is-on', d === i);
    }
    function settle() {
      if (!looping()) return;
      if (rail.scrollLeft < setW - step / 2) jump(rail.scrollLeft + setW);
      else if (rail.scrollLeft >= setW * 2 - step / 2) jump(rail.scrollLeft - setW);
    }
    function init() {
      root.classList.toggle('is-static', !mq.matches);
      measure();
      if (looping()) jump(setW);
      setDots();
    }
    rail.addEventListener('scroll', function () {
      setDots();
      clearTimeout(timer);
      timer = setTimeout(settle, 140);
    }, { passive: true });
    if (mq.addEventListener) mq.addEventListener('change', init);
    window.addEventListener('resize', function () { measure(); });
    init();
  })();
</script>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Collection chips",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Tiles mirror this menu. Edit it under Navigation, never in code. On desktop they all sit in one row, so keep the list short."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "tiles", "label": "Drawn tiles" },
        { "value": "pills", "label": "Thin pills" }
      ],
      "default": "tiles",
      "info": "Tiles show the drawing for each collection. A collection with no drawing shows its collection image."
    },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Renders in capitals." },
    { "type": "color", "id": "outline_color", "label": "Pill outline", "default": "#1F2328" },
    { "type": "range", "id": "outline_strength", "label": "Outline strength", "min": 10, "max": 100, "step": 10, "unit": "%", "default": 100 },
    { "type": "color", "id": "active_bg", "label": "Current item colour", "default": "#1F2328", "info": "No hover colour. Marks only the collection you are on." },
    { "type": "color", "id": "active_text", "label": "Current pill text", "default": "#F6EEE8" },
    { "type": "range", "id": "text_size", "label": "Label size, mobile", "min": 10, "max": 14, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "text_size_desktop", "label": "Label size, desktop", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "checkbox", "id": "stretch_desktop", "label": "Stretch row to page width on desktop", "default": true, "info": "Kept for older templates. The row fills the page width on its own." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 12 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 28 }
  ],
  "presets": [
    { "name": "Collection chips", "category": "Navigation", "settings": { "heading": "Shop by collection" } }
  ]
}
{% endschema %}
