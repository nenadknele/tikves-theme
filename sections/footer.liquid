{%- liquid
  assign show_selectors = false
  assign currency_selector = false
  assign locale_selector = false

  if section.settings.show_currency_selector and shop.enabled_currencies.size > 1
    assign currency_selector = true
  endif

  if section.settings.show_locale_selector and shop.enabled_locales.size > 1
    assign locale_selector = true
  endif

  if currency_selector or locale_selector
    assign show_selectors = true
  endif
-%}

{%- if settings.color_footer == settings.color_body_bg -%}
  {%- style -%}
    .site-footer {
      border-top: 1px solid {{ settings.color_borders }};
    }
  {%- endstyle -%}
{%- endif -%}

<footer class="site-footer" data-section-id="{{ section.id }}" data-section-type="footer-section">
  <div class="page-width">

    {%- for block in section.blocks -%}
      {%- if block.type == 'newsletter' -%}
        {%- style -%}
          .tl-footer-news {
            max-width: 520px;
            margin: 0 auto;
            text-align: center;
          }
          .tl-footer-news .tl-stay-in-touch { padding-top: 8px; padding-bottom: 0; }
          .tl-footer-news .tl-stay-in-touch__text { margin-left: auto; margin-right: auto; }
          .tl-footer-news .tl-join {
            flex-direction: row;
            max-width: 460px;
            margin: 0 auto;
          }
          .tl-footer-news .tl-join__input { flex: 1 1 auto; }
          .tl-footer-news .tl-join__btn { width: auto; flex: 0 0 auto; padding: 0 28px !important; }
          .tl-footer-news .tl-join__fine { margin-left: auto; margin-right: auto; }
          .tl-footer-news .tl-stay-in-touch__social { display: none; }
          .tl-footer-news-rule {
            border: none;
            height: 1px;
            background-color: currentColor;
            opacity: 0.2;
            margin: 36px 0 40px;
          }
          @media only screen and (max-width: 480px) {
            .tl-footer-news .tl-join { flex-direction: column; }
            .tl-footer-news .tl-join__btn { width: 100%; }
          }
        {%- endstyle -%}
        <div class="tl-footer-news" {{ block.shopify_attributes }}>
          {%- render 'footer-newsletter', block: block -%}
        </div>
        <hr class="tl-footer-news-rule">
      {%- endif -%}
    {%- endfor -%}

    {%- style -%}
      .site-footer .grid__item[data-type="menu"] {
        float: none;
        clear: both;
        width: 100%;
        padding-top: 0;
        padding-bottom: 0;
        margin: 0;
        text-align: center;
      }
      .site-footer .grid__item[data-type="menu"]:after { display: none; }
      .site-footer .grid__item[data-type="menu"] .footer__collapsible { padding: 0; }
      .site-footer .grid__item[data-type="menu"] .site-footer__linklist a { padding: 7px 0; }
      .site-footer .footer__clear { display: none; }
      @media only screen and (min-width: 769px) {
        .site-footer .grid__item[data-type="menu"] .site-footer__linklist li {
          display: inline-block;
          margin: 0 14px;
        }
      }
    {%- endstyle -%}
    <div class="grid">
      {%- assign row_width = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'newsletter' -%}{%- continue -%}{%- endif -%}
        {%- assign row_width = row_width | plus: block.settings.container_width -%}
        {%- if row_width > 100 -%}
          <div class="footer__clear small--hide"></div>
          {%- assign row_width = row_width | minus: 100 -%}
        {%- endif -%}

        <div {{ block.shopify_attributes }} class="grid__item footer__item--{{ block.id }}{% if block.type == 'menu' and block.settings.tl_desktop_only %} tl-ft-desktop-only{% endif %}" data-type="{{ block.type }}">
          {%- style -%}
            @media only screen and (min-width: 769px) and (max-width: 959px) {
              .footer__item--{{ block.id }} {
                width: 50%;
                padding-top: 40px;
              }
              .footer__item--{{ block.id }}:nth-child(2n + 1) {
                clear: left;
              }
            }
            @media only screen and (min-width: 960px) {
              .footer__item--{{ block.id }} {
                width: {{ block.settings.container_width }}%;
              }

            }
          {%- endstyle -%}

          {%- liquid
            case block.type
              when 'logo_social'
                render 'footer-logo', block: block
              when 'custom'
                render 'footer-custom-text', block: block, container_width: block.settings.container_width
              when 'newsletter'
                render 'footer-newsletter', block: block
              when 'menu'
                render 'footer-menu', block: block
              when 'follow_shop_cta'
                render 'follow-shop-cta', block: block
            endcase
          -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if show_selectors -%}
      <div class="footer__section">
        {%- render 'multi-selectors',
          locale_selector: locale_selector,
          currency_selector: currency_selector,
          show_currency_flags: section.settings.show_currency_flags
          location: 'footer'
        -%}
      </div>
    {%- endif -%}

    {%- liquid
      assign tel = section.settings.contact_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
      assign first_char = tel | slice: 0
      if first_char == '0'
        assign tel = tel | slice: 1, 20 | prepend: '+44'
      endif
    -%}
    {%- style -%}
      .tl-footer-bottom {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
        text-align: center;
        margin: 32px 0 28px;
        padding-top: 36px;
        border-top: 1px solid rgba(128, 128, 128, 0.3);
        border-top-color: color-mix(in srgb, currentColor 20%, transparent);
      }
      .tl-footer-bottom .social-icons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        margin: 0;
        padding: 0;
      }
      .tl-footer-bottom .social-icons li {
        margin: 0 12px;
      }
      .tl-footer-bottom__contact {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
      }
      .footer__contact-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: inherit;
        text-decoration: none;
      }
      .footer__contact-link:hover span,
      .footer__contact-link:focus span {
        text-decoration: underline;
      }
      .footer__contact-link svg {
        width: 16px;
        height: 16px;
        flex: 0 0 16px;
      }
    {%- endstyle -%}
    <div class="tl-footer-bottom footer__section">
      {% render 'social-icons', additional_classes: 'footer__social' %}
      {%- if section.settings.contact_phone != blank or section.settings.contact_email != blank -%}
        <div class="tl-footer-bottom__contact">
          {%- if section.settings.contact_phone != blank -%}
            <a class="footer__contact-link" href="tel:{{ tel }}">
              <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span>{{ section.settings.contact_phone }}</span>
            </a>
          {%- endif -%}
          {%- if section.settings.contact_email != blank -%}
            <a class="footer__contact-link" href="mailto:{{ section.settings.contact_email }}">
              <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
              <span>{{ section.settings.contact_email }}</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
      <a class="footer__contact-link footer__preferred-source" href="https://google.com/preferences/source?q=tikveslondon.uk" target="_blank" rel="noopener">
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 16.8l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8z"/></svg>
        <span>Add us as a preferred source on Google</span>
      </a>
    </div>

    <div class="tl-ft-bar">
    {%- if section.settings.security_line != blank -%}
      <p class="tl-footer-secure" style="max-width: 420px; margin: 0 auto 22px; text-align: center; text-wrap: balance;">{{ section.settings.security_line }}</p>
    {%- endif -%}

    {%- if section.settings.show_payment_icons -%}
      {%- unless shop.enabled_payment_types == empty -%}
        {%- style -%}
          .tl-footer-payments {
            display: block;
            max-width: 340px;
            margin: 0 auto 30px;
            padding: 0;
            text-align: center;
            text-wrap: balance;
            font-size: 0;
            line-height: 0;
          }
          .tl-footer-payments li {
            display: inline-block;
            margin: 4px;
            vertical-align: middle;
          }
          .tl-footer-payments svg {
            display: block;
            width: 38px;
            height: 24px;
          }
          @media only screen and (min-width: 769px) {
            .tl-footer-payments { max-width: 560px; }
          }
        {%- endstyle -%}
        <ul class="inline-list payment-icons tl-footer-payments footer__section" aria-label="Ways to pay">
          {%- for type in shop.enabled_payment_types -%}
            <li class="icon--payment">
              {{ type | payment_type_svg_tag }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endunless -%}
    {%- endif -%}

    {%- if section.settings.legal_line != blank -%}
      <hr style="border: none; height: 1px; background-color: currentColor; opacity: 0.2;">
      <p class="footer__small-text">{{ section.settings.legal_line }}</p>
    {%- endif -%}
    {%- if section.settings.show_copyright -%}
      <p class="footer__small-text">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
        {%- if section.settings.copyright_text != blank -%}
          {{ section.settings.copyright_text }}
        {%- endif -%}
      </p>
    {%- endif -%}
    </div>

    {%- comment -%}
      DESKTOP FOOTER IN OVERTONE'S SHAPE, 16 Nov 2026, his word: "i want our
      footer on desktop to look as much as possible to overtone.co footer".
      From 960px up: the signup sits in a wide column on the left with the
      social icons and the contact lines under it, the menus stand beside it
      as columns with a heading each, and a ruled bar at the foot carries the
      copyright on the left and the payment icons on the right. Under 960px
      nothing here applies and the footer is the centred stack it was.
      Layout only. Our own type and colours. No wording changes.
    {%- endcomment -%}
    {%- comment -%}
      MOBILE DROPDOWNS, 20 Nov 2026, his word: "the footer on mobile is too
      long i need dropdown menu". Under 960px each menu (Shop, About, Help,
      Legal) folds into a heading row that opens on tap. From 960px up the
      button is hidden and the columns show in full, as before.
    {%- endcomment -%}
    {%- style -%}
      .tl-ft-acc-btn { display: none; }
      @media only screen and (max-width: 959px) {
        .site-footer .grid__item[data-type="menu"] { border-bottom: 1px solid rgba(128, 128, 128, 0.3); border-bottom-color: color-mix(in srgb, currentColor 20%, transparent); }
        .tl-ft-acc-btn {
          display: flex;
          align-items: center;
          justify-content: space-between;
          width: 100%;
          min-height: 56px;
          padding: 0 4px;
          margin: 0;
          background: none;
          border: 0;
          color: inherit;
          font: inherit;
          font-size: 15px;
          letter-spacing: 0.06em;
          text-transform: uppercase;
          text-align: left;
          cursor: pointer;
        }
        .tl-ft-acc-btn svg { flex: 0 0 auto; transition: transform 0.2s ease; }
        .tl-ft-acc-btn[aria-expanded="true"] svg { transform: rotate(180deg); }
        .site-footer .tl-ft-acc-panel { display: none; text-align: left; padding: 0 4px 14px; }
        .site-footer .tl-ft-acc-btn[aria-expanded="true"] ~ div .tl-ft-acc-panel { display: block; }
      }
    {%- endstyle -%}
    <script>
      (function () {
        if (window.tlFtAcc) return;
        window.tlFtAcc = true;
        document.addEventListener('click', function (e) {
          var btn = e.target.closest && e.target.closest('.tl-ft-acc-btn');
          if (!btn) return;
          btn.setAttribute('aria-expanded', btn.getAttribute('aria-expanded') === 'true' ? 'false' : 'true');
        });
      })();
    </script>

    {%- style -%}
      .tl-ft-coltitle { display: none; }
      @media only screen and (max-width: 959px) {
        .site-footer .grid__item.tl-ft-desktop-only { display: none; }
      }
      @media only screen and (min-width: 960px) {
        .site-footer { padding-top: 76px; padding-bottom: 0; }
        .site-footer > .page-width {
          display: grid;
          grid-template-columns: minmax(0, 31%) minmax(0, 1fr);
          grid-template-rows: auto 1fr auto;
          grid-template-areas: "news cols" "contact cols" "bar bar";
          column-gap: 7%;
        }

        /* Left column: the signup. */
        .site-footer .tl-footer-news {
          grid-area: news;
          max-width: none;
          margin: 0 0 0 clamp(0px, 5vw, 110px);
          text-align: left;
        }
        .site-footer .tl-footer-news-rule { display: none; }
        .site-footer .tl-footer-news .tl-stay-in-touch { padding: 0; }
        .site-footer .tl-footer-news .footer__title,
        .site-footer .tl-ft-coltitle {
          display: block;
          font-size: 21px;
          line-height: 1.2;
          letter-spacing: 0.06em;
          text-transform: uppercase;
          margin: 0 0 30px;
          padding: 0;
          text-align: left;
        }
        .site-footer .tl-footer-news .tl-stay-in-touch__text {
          max-width: 440px;
          margin: 0 0 14px;
          font-size: 15px;
        }
        .site-footer .tl-footer-news .tl-join {
          flex-direction: column;
          gap: 20px;
          max-width: 440px;
          margin: 0;
        }
        .site-footer .tl-footer-news .tl-join__input {
          height: 52px !important;
          padding: 0 !important;
          border: 0;
          border-bottom: 1px solid #1F2328;
          font-size: 16px;
        }
        .site-footer .tl-footer-news .tl-join__input:focus { border-bottom-color: #A64029; }
        .site-footer .tl-footer-news .tl-join__btn {
          width: 100%;
          height: 42px !important;
          font-weight: 600;
        }
        .site-footer .tl-footer-news .tl-join__fine {
          max-width: 440px;
          margin: 14px 0 0;
        }
        .site-footer .tl-footer-news .tl-stay-in-touch__social {
          display: flex;
          flex-wrap: wrap;
          margin: 30px 0 0 -8px;
          padding: 0;
        }
        .site-footer .tl-footer-news .tl-stay-in-touch__social li { margin: 0 14px 0 0; }

        /* Left column, under the signup: phone, email, the Google line. */
        .site-footer .tl-footer-bottom {
          grid-area: contact;
          align-self: start;
          align-items: flex-start;
          gap: 10px;
          text-align: left;
          margin: 26px 0 0 clamp(0px, 5vw, 110px);
          padding-top: 0;
          border-top: 0;
          font-size: 14px;
        }
        .site-footer .tl-footer-bottom .social-icons { display: none; }
        .site-footer .tl-footer-bottom__contact { align-items: flex-start; }

        /* Right: one column per menu, heading on top. */
        .site-footer > .page-width > .grid {
          grid-area: cols;
          display: grid;
          grid-auto-flow: column;
          grid-auto-columns: minmax(0, 1fr);
          column-gap: 28px;
          margin: 0 clamp(0px, 3vw, 60px) 0 0;
        }
        .site-footer > .page-width > .grid:before,
        .site-footer > .page-width > .grid:after { display: none; }
        .site-footer .grid__item[data-type="menu"] {
          float: none;
          width: auto;
          padding: 0;
          text-align: left;
        }
        .site-footer .grid__item[data-type="menu"] .site-footer__linklist li {
          display: block;
          margin: 0 0 20px;
        }
        .site-footer .grid__item[data-type="menu"] .site-footer__linklist a {
          padding: 0;
          font-size: 15px;
          line-height: 1.4;
        }
        .site-footer .grid__item[data-type="menu"] .site-footer__linklist a:hover { text-decoration: underline; }

        /* The bar: copyright left, ways to pay right. */
        .site-footer .tl-ft-bar {
          grid-area: bar;
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto;
          grid-template-areas: "copy pay" "secure pay";
          align-items: center;
          column-gap: 32px;
          margin-top: 64px;
          padding: 22px 0 24px;
          border-top: 1px solid #1F2328;
        }
        .site-footer .tl-ft-bar .footer__small-text {
          grid-area: copy;
          padding: 0;
          text-align: left;
          font-size: 15px;
        }
        .site-footer .tl-ft-bar .tl-footer-secure {
          grid-area: secure;
          max-width: none !important;
          margin: 4px 0 0 !important;
          text-align: left !important;
          font-size: 12px;
          opacity: 0.7;
        }
        .site-footer .tl-ft-bar .tl-footer-payments {
          grid-area: pay;
          max-width: none;
          margin: 0;
          text-align: right;
        }
        .site-footer .tl-ft-bar .tl-footer-payments li { margin: 3px 0 3px 8px; }
      }
    {%- endstyle -%}

  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.footer.settings.header_localization"
    },
    {
      "type": "checkbox",
      "id": "show_currency_selector",
      "label": "t:sections.footer.settings.show_currency_selector.label",
      "default": true,
      "info": "t:sections.footer.settings.header_currency_selector"
    },
    {
      "type": "checkbox",
      "id": "show_currency_flags",
      "label": "t:sections.footer.settings.show_currency_flags.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_locale_selector",
      "label": "t:sections.footer.settings.show_locale_selector.label",
      "default": true,
      "info": "t:sections.footer.settings.header_language_selector"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header_additional_footer_content"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Contact phone",
      "info": "Shown centred under the social icons, tap to call on a phone. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "info": "Shown under the phone, tap to email. Leave blank to hide."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.settings.show_payment_icons.label",
      "default": false
    },
    {
      "type": "text",
      "id": "security_line",
      "label": "Security line",
      "info": "One short sentence shown above the payment icons. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "legal_line",
      "label": "Legal identity line",
      "info": "Statutory disclosure. Must match the registered office shown on Companies House.",
      "default": "Tikveš London Ltd, 11 Redan House, 23 Redan Place, London W2 4SA. Company No. 07356331. Registered in England and Wales."
    },
    {
      "type": "checkbox",
      "id": "show_copyright",
      "label": "t:sections.footer.settings.show_copyright.label"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "t:sections.footer.settings.copyright_text.label"
    }
  ],
  "blocks": [
    {
      "type": "logo_social",
      "name": "t:sections.footer.blocks.logo.name",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:sections.footer.blocks.logo.settings.logo.label"
        },
        {
          "type": "range",
          "id": "desktop_logo_height",
          "label": "t:sections.footer.blocks.logo.settings.desktop_logo_height.label",
          "default": 50,
          "min": 20,
          "max": 120,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "container_width",
          "label": "t:sections.footer.blocks.logo.settings.container_width.label",
          "default": 25,
          "min": 15,
          "max": 95,
          "unit": "%"
        }
      ]
    },
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.navigation.name",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_footer_title",
          "label": "t:sections.footer.blocks.navigation.settings.show_footer_title.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.navigation.settings.menu.label",
          "default": "footer",
          "info": "t:sections.footer.blocks.navigation.settings.menu.info"
        },
        {
          "type": "checkbox",
          "id": "tl_desktop_only",
          "label": "Desktop only",
          "info": "Shows this menu as a column on wide screens and hides it on phones and tablets.",
          "default": false
        },
        {
          "type": "range",
          "id": "container_width",
          "label": "t:sections.footer.blocks.navigation.settings.container_width.label",
          "default": 25,
          "min": 15,
          "max": 95,
          "unit": "%"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter_and_social.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_footer_title",
          "label": "t:sections.footer.blocks.newsletter_and_social.settings.show_footer_title.label",
          "default": true
        },
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.newsletter_and_social.settings.content"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.footer.blocks.newsletter_and_social.settings.title.label",
          "default": "Sign up and save"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.footer.blocks.newsletter_and_social.settings.text.label",
          "info": "t:sections.footer.blocks.newsletter_and_social.settings.text.info",
          "default": "<p>One email when there is something worth saying. Never more.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_form",
          "label": "Show email signup",
          "info": "Untick to show only the heading, text and social icons.",
          "default": true
        },
        {
          "type": "range",
          "id": "container_width",
          "label": "t:sections.footer.blocks.newsletter_and_social.settings.container_width.label",
          "default": 25,
          "min": 15,
          "max": 95,
