{%- comment -%}
  TIKVES LONDON . SINGLES
  One bottle per view on mobile, swipe for the next. A grid on desktop.
  Every card carries its own Add to cart button, so a customer can buy
  from the home page without opening the product page. Sold-out lines
  stay in the row and read as sold out.

  Operator ruling 4 Sep 2026: no two-column grid of bottles on the home
  page. Replaces featured-collection for the singles row and
  tikves-shelf for the rakija, and carries the Top trending row.
  Keep the section keys in tikves-home-design so band and padding apply.

  Buy button is Terra Rossa, round. The See all button is Paper with Ink
  text and an Ink outline, filling Terra Rossa on hover. The line under
  the heading is forced to body size and sentence case.

  28 Sep 2026, speed: two more sizes in the srcset, so a phone fetches the
  size nearest its screen instead of the next one up.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign col = collections[s.collection]
  assign per_row = s.per_row | default: 4
  assign limit = s.limit | default: 8
-%}

<div id="tksg-{{ section.id }}" class="tksg" data-section-id="{{ section.id }}" data-section-type="tikves-singles">

  {%- if s.title != blank or s.intro != blank -%}
    <div class="page-width">
      <div class="section-header">
        {%- if s.title != blank -%}
          <h2 class="section-header__title {{ s.heading_size }}">{{ s.title | escape }}</h2>
        {%- endif -%}
        {%- if s.intro != blank -%}
          <p class="tksg__intro">{{ s.intro | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="page-width">
    <div class="tksg__track">
      {%- if s.collection == blank or col.empty? or col.products_count == 0 -%}
        {%- comment -%} Nothing to show. Renders empty rather than placeholders. {%- endcomment -%}
      {%- else -%}
        {%- for product in col.products limit: limit -%}
          {%- liquid
            assign v = product.selected_or_first_available_variant | default: product.variants.first
            assign img = product.featured_media.preview_image
            assign line = product.metafields.custom.tile_line
          -%}
          <article class="tksg__card" data-product-handle="{{ product.handle }}">
            <a class="tksg__frame" href="{{ product.url | within: col }}">
              {%- if img != blank -%}
                <img
                  src="{{ img | image_url: width: 800 }}"
                  srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1000 }} 1000w, {{ img | image_url: width: 1200 }} 1200w"
                  sizes="(min-width: 769px) 22vw, 82vw"
                  alt="{{ img.alt | default: product.title | escape }}"
                  width="{{ img.width }}"
                  height="{{ img.height }}"
                  loading="lazy">
              {%- endif -%}
            </a>
            <div class="tksg__meta">
              <a class="tksg__title grid-product__title grid-product__title--{{ settings.type_product_style }}" href="{{ product.url | within: col }}">{{ product.title }}</a>
              {%- if line != blank -%}
                <div class="tksg__line">{{ line }}</div>
              {%- endif -%}
              <div class="tksg__price">{{ product.price | money }}</div>
              {%- if product.available == false -%}
                <button type="button" class="tksg__btn" disabled aria-disabled="true">{{ 'products.product.sold_out' | t }}</button>
              {%- elsif product.variants.size > 1 -%}
                <a class="tksg__btn" href="{{ product.url | within: col }}">{{ 'products.product.add_to_cart' | t }}</a>
              {%- else -%}
                <form class="tksg__form" action="{{ routes.cart_add_url }}" method="post" data-tk-gatc>
                  <input type="hidden" name="id" value="{{ v.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="tksg__btn">{{ 'products.product.add_to_cart' | t }}</button>
                </form>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  {%- if s.link_label != blank and col != blank -%}
    <div class="page-width text-center tksg__link">
      <a href="{{ col.url }}" class="tksg__browse">{{ s.link_label | escape }}</a>
    </div>
  {%- endif -%}
</div>

{% style %}
  #tksg-{{ section.id }} .tksg__intro {
    max-width: 46ch;
    margin: 10px auto 0 !important;
    text-align: center !important;
    font-family: inherit;
    font-size: 15px !important;
    line-height: 1.5 !important;
    font-weight: 400 !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
    opacity: 0.8;
  }
  #tksg-{{ section.id }} .tksg__track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 0 0 8px;
    scrollbar-width: none;
  }
  #tksg-{{ section.id }} .tksg__track::-webkit-scrollbar { display: none; }
  #tksg-{{ section.id }} .tksg__card { flex: 0 0 82%; scroll-snap-align: start; }
  #tksg-{{ section.id }} .tksg__frame { display: block; aspect-ratio: 4 / 5; background: #F5EFE7; overflow: hidden; }
  #tksg-{{ section.id }} .tksg__frame img { width: 100%; height: 100%; object-fit: contain; display: block; }
  #tksg-{{ section.id }} .tksg__meta { padding: 14px 0 0; }
  #tksg-{{ section.id }} .tksg__title { display: block; text-decoration: none; margin: 0 0 4px; }
  #tksg-{{ section.id }} .tksg__line { font-size: 14px; opacity: 0.75; margin: 0 0 6px; }
  #tksg-{{ section.id }} .tksg__price { font-size: 16px; margin: 0 0 12px; }
  #tksg-{{ section.id }} .tksg__form { margin: 0; }
  #tksg-{{ section.id }} .tksg__btn {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 15px 18px;
    border: 1px solid #A64029;
    border-radius: 999px;
    background: #A64029;
    color: #FFFFFF;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    line-height: 1.3;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  #tksg-{{ section.id }} .tksg__btn:hover { background: #8E3623; border-color: #8E3623; color: #FFFFFF; }
  #tksg-{{ section.id }} .tksg__btn[disabled] { background: transparent; color: #1F2328; border-color: #B9AC9B; opacity: 0.7; cursor: default; }
  #tksg-{{ section.id }} .tksg__link { margin-top: 24px; }
  #tksg-{{ section.id }} .tksg__browse {
    display: inline-block;
    min-width: 220px;
    box-sizing: border-box;
    padding: 15px 28px;
    border-radius: 999px;
    background: #F5EFE7;
    color: #1F2328;
    border: 1px solid #1F2328;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  #tksg-{{ section.id }} .tksg__browse:hover,
  #tksg-{{ section.id }} .tksg__browse:focus-visible {
    background: #A64029;
    border-color: #A64029;
    color: #FFFFFF;
  }
  @media only screen and (min-width: 769px) {
    #tksg-{{ section.id }} .tksg__intro { font-size: 16px !important; }
    #tksg-{{ section.id }} .tksg__track {
      display: grid;
      grid-template-columns: repeat({{ per_row }}, minmax(0, 1fr));
      gap: 24px;
      overflow: visible;
      padding: 0;
    }
    #tksg-{{ section.id }} .tksg__card { flex: none; }
    #tksg-{{ section.id }} .tksg__link { margin-top: 32px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Tikves singles",
  "class": "index-section",
  "settings": [
    { "type": "paragraph", "content": "One bottle per view on mobile with an Add to cart button on every card. A grid on desktop." },
    { "type": "text", "id": "title", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h3",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ]
    },
    { "type": "textarea", "id": "intro", "label": "Line under the heading" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "How many products", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "per_row", "label": "Products per row, desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "text", "id": "link_label", "label": "Button label under the row", "info": "Links to the collection. Leave empty for no button." }
  ],
  "presets": [{ "name": "Tikves singles", "category": "Tikves" }],
  "disabled_on": { "groups": ["footer", "header", "custom.popups"] }
}
{% endschema %}
