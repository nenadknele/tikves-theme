{%- liquid
  assign s = section.settings
-%}

<div class="tkv tkv--{{ section.id }}">
  <div class="page-width">
    {%- if s.title != blank -%}
      <div class="tkv__head">
        <h2 class="{{ s.heading_size }}">{{ s.title | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="tkv__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="tkv__item" {{ block.shopify_attributes }}>
          {%- if b.image != blank -%}
            <div class="tkv__portrait">
              {%- comment -%} 28 Sep 2026, speed: sizes matches the portrait width, so a phone fetches the small file. {%- endcomment -%}
              <img src="{{ b.image | image_url: width: 480 }}" srcset="{{ b.image | image_url: width: 260 }} 260w, {{ b.image | image_url: width: 390 }} 390w, {{ b.image | image_url: width: 480 }} 480w" sizes="{{ s.portrait_size }}px" alt="{{ b.name | escape }}" width="240" height="240" loading="lazy">
            </div>
          {%- endif -%}
          {%- if b.quote != blank -%}
            <blockquote class="tkv__quote rte">{{ b.quote }}</blockquote>
          {%- endif -%}
          {%- if b.name != blank -%}
            <div class="tkv__name">{{ b.name | escape }}</div>
          {%- endif -%}
          {%- if b.role != blank -%}
            <div class="tkv__role">{{ b.role | escape }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if s.credit != blank -%}
      <div class="tkv__credit">{{ s.credit | escape }}</div>
    {%- endif -%}
  </div>
</div>

{% style %}
  .tkv--{{ section.id }} {
    padding: 34px 0;
    background: {{ s.color_background }};
    color: {{ s.color_text }};
  }
  .tkv--{{ section.id }} .tkv__head { text-align: center; margin-bottom: 26px; }
  .tkv--{{ section.id }} .tkv__head h2 { margin: 0; }
  .tkv--{{ section.id }} .tkv__grid { display: block; }
  .tkv--{{ section.id }} .tkv__item { text-align: center; max-width: 460px; margin: 0 auto 34px; }
  .tkv--{{ section.id }} .tkv__item:last-child { margin-bottom: 0; }
  .tkv--{{ section.id }} .tkv__portrait {
    width: {{ s.portrait_size }}px;
    height: {{ s.portrait_size }}px;
    margin: 0 auto 16px;
    overflow: hidden;
    {% if s.round_images %}border-radius: 50%;{% endif %}
    background: {{ settings.color_small_image_bg }};
  }
  .tkv--{{ section.id }} .tkv__portrait img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tkv--{{ section.id }} .tkv__quote { margin: 0 0 14px; font-size: 16px; line-height: 1.6; }
  .tkv--{{ section.id }} .tkv__quote p { margin: 0 0 8px; }
  .tkv--{{ section.id }} .tkv__quote p:last-child { margin-bottom: 0; }
  .tkv--{{ section.id }} .tkv__name { font-size: 15px; font-weight: 600; }
  .tkv--{{ section.id }} .tkv__role { font-size: 14px; opacity: 0.72; margin-top: 2px; }
  .tkv--{{ section.id }} .tkv__credit { margin-top: 28px; text-align: center; font-size: 12px; opacity: 0.6; }

  @media only screen and (min-width: 769px) {
    .tkv--{{ section.id }} { padding: 58px 0; }
    .tkv--{{ section.id }} .tkv__grid { display: grid; grid-template-columns: repeat({{ section.blocks.size | at_most: 3 }}, minmax(0, 1fr)); gap: 46px; align-items: start; }
    .tkv--{{ section.id }} .tkv__item { margin: 0; max-width: none; }
    .tkv--{{ section.id }} .tkv__quote { font-size: 17px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Tikves voices",
  "class": "index-section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "In their own words" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "default": "h3", "options": [ { "value": "h3", "label": "Small" }, { "value": "h2", "label": "Medium" }, { "value": "h1", "label": "Large" } ] },
    { "type": "range", "id": "portrait_size", "label": "Portrait size", "min": 80, "max": 200, "step": 10, "unit": "px", "default": 130 },
    { "type": "checkbox", "id": "round_images", "label": "Round portraits", "default": true },
    { "type": "text", "id": "credit", "label": "Photographer credit line" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#F5EFE7" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#1F2328" }
  ],
  "blocks": [
    {
      "type": "voice",
      "name": "Voice",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Portrait" },
        { "type": "richtext", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Title" }
      ]
    }
  ],
  "presets": [ { "name": "Tikves voices" } ],
  "disabled_on": { "groups": ["footer", "header", "custom.popups"] }
}
{% endschema %}
