{% style %}
  #NewsletterPopup-{{ section.id }} .modal__centered {
    position: relative;
  }

  #NewsletterPopup-{{ section.id }} .modal__close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 44px;
    height: 44px;
    min-width: 0;
    padding: 15px;
    display: block;
    font-size: 0;
    line-height: 0;
    overflow: hidden;
    z-index: 2;
  }

  #NewsletterPopup-{{ section.id }} .modal__close::after {
    content: none;
  }

  #NewsletterPopup-{{ section.id }} .modal__close .icon {
    width: 14px;
    height: 14px;
    display: block;
  }

  #NewsletterPopup-{{ section.id }} .tl-pop-no {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 8px;
    margin-top: 4px;
    background: none;
    border: 0;
    color: inherit;
    font-size: 13px;
    line-height: 1.2;
    text-decoration: underline;
    cursor: pointer;
  }

  #NewsletterPopup-{{ section.id }} .tl-pop-no::after {
    content: none;
  }

  #NewsletterPopup-{{ section.id }} .popup-cta .btn,
  #NewsletterPopup-{{ section.id }} .popup-cta button[type="submit"],
  #NewsletterPopup-{{ section.id }} .popup-cta .newsletter__submit {
    border-radius: 0;
  }

  @media (max-width: 749px) {
    #NewsletterPopup-{{ section.id }} .modal__close {
      top: 4px;
      right: 4px;
    }
  }
{% endstyle %}

{%- comment -%}
  22 Oct 2026, operator instruction. NO JOINING GIFT POPUP ON BROADCAST OFFER PAGES.
  An offer page carries a code that combines with nothing, so a second offer
  popping up over it would hand the customer a code that cannot be used with
  the one they came for. Add a page handle to tl_offer_pages to keep the popup
  off another offer page. The popup still runs everywhere else, unchanged.
{%- endcomment -%}
{%- assign tl_offer_pages = 'babuna-six' | split: ',' -%}
{%- assign tl_hide_popup = false -%}
{%- if section.settings.disable_for_account_holders and customer -%}
  {%- assign tl_hide_popup = true -%}
{%- endif -%}
{%- if request.page_type == 'page' and tl_offer_pages contains page.handle -%}
  {%- assign tl_hide_popup = true -%}
{%- endif -%}

{% unless tl_hide_popup %}

{% for block in section.blocks %}
  {% if block.type == 'header' %}
    {% assign has_reminder = true %}
  {% endif %}
{% endfor %}

<div
  id="NewsletterPopup-{{ section.id }}"
  class="modal modal--square modal--mobile-friendly"
  data-section-id="{{ section.id }}"
  data-section-type="newsletter-popup"
  data-delay-days="{{ section.settings.popup_days }}"
  data-has-reminder="{{ has_reminder }}"
  data-delay-seconds="{{ section.settings.popup_seconds }}"
  {% if section.settings.popup_image != blank %}data-has-image{% endif %}
  data-test-mode="{{ request.design_mode }}">
  <div class="modal__inner">
    <div class="modal__centered medium-up--text-center">
      <div class="modal__centered-content {% if section.settings.popup_image != blank %}newsletter--has-image{% endif %}">

        <div class="newsletter newsletter-popup {% if section.settings.image_position == 'right' %}newsletter-popup--image-reversed{% endif %}">
          {% if section.settings.popup_image != blank %}
            <div class="newsletter-popup__image-wrapper">
              {%- render 'image-element',
                img: section.settings.popup_image,
                img_width: 1000,
                sizeVariable: '400px',
                classes: 'newsletter-popup__image',
              -%}
            </div>
          {% endif %}

          <div class="newsletter-popup__content">
            {%- if section.settings.popup_logo != blank -%}
              <div class="tl-pop-logo" style="width: {{ section.settings.logo_width }}px;">
                {%- render 'image-element',
                  img: section.settings.popup_logo,
                  img_width: 600,
                  sizeVariable: '260px',
                  classes: 'tl-pop-logo__img',
                -%}
              </div>
              {%- if section.settings.logo_rule -%}
                <span class="tl-pop-rule"></span>
              {%- endif -%}
            {%- endif -%}

            {%- if section.settings.line_small != blank or section.settings.line_big != blank or section.settings.line_sub != blank -%}
              <h3 class="tl-pop-head" style="margin-top: {{ section.settings.logo_gap }}px;">
                {%- if section.settings.line_small != blank -%}
                  <span class="tl-pop-small">{{ section.settings.line_small }}</span>
                {%- endif -%}
                {%- if section.settings.line_big != blank -%}
                  <span class="tl-pop-big">{{ section.settings.line_big }}</span>
                {%- endif -%}
                {%- if section.settings.line_sub != blank -%}
                  <span class="tl-pop-sub">{{ section.settings.line_sub }}</span>
                {%- endif -%}
              </h3>
            {%- endif -%}

            {%- if section.settings.popup_text != blank -%}
              <div class="rte">
                {{ section.settings.popup_text }}
              </div>
            {%- endif -%}

            {%- if section.settings.enable_newsletter -%}
              <div class="popup-cta">
                {%- render 'newsletter-form',
                  section_id: section.id,
                  snippet_context: 'popup',
                  placeholder_text: section.settings.input_placeholder,
                  submit_text: section.settings.submit_label
                -%}
              </div>
            {%- endif -%}

            {%- if section.settings.fineprint != blank -%}
              <p class="tl-pop-fine">{{ section.settings.fineprint }}</p>
            {%- endif -%}

            {% if section.settings.button_label != blank %}
              <a href="{{ section.settings.button_link }}" class="btn newsletter-button">
                <div class="button--text">
                  {{ section.settings.button_label }}
                </div>
              </a>
            {% endif %}

            {% if section.settings.show_social_icons %}
              {% render 'social-icons', additional_classes: 'inline-list' %}
            {% endif %}

            {%- if section.settings.decline_label != blank -%}
              <button type="button" class="tl-pop-no js-modal-close">{{ section.settings.decline_label }}</button>
            {%- endif -%}
          </div>
        </div>
      </div>

      <button type="button" class="modal__close js-modal-close text-link" aria-label="Close">
        <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"><path d="m19 17.61 27.12 27.13m0-27.12L19 44.74"/></svg>
      </button>
    </div>
  </div>
</div>

{% for block in section.blocks %}
  {% if block.type == 'header' %}
    {% render 'newsletter-reminder',
      section: section,
      block: block
    %}
  {% endif %}
{% endfor %}

{% endunless %}

{% schema %}
  {
    "name": "t:sections.newsletter-popup.name",
    "max_blocks": 1,
    "class": "index-section--hidden",
    "settings": [
      {
        "type": "checkbox",
        "id": "disable_for_account_holders",
        "label": "t:sections.newsletter-popup.settings.disable_for_account_holders.label",
        "default": true,
        "info": "t:sections.newsletter-popup.settings.disable_for_account_holders.info"
      },
      {
        "type": "range",
        "id": "popup_seconds",
        "label": "t:sections.newsletter-popup.settings.popup_seconds.label",
        "info": "t:sections.newsletter-popup.settings.popup_seconds.info",
        "default": 5,
        "min": 2,
        "max": 60,
        "step": 1,
        "unit": "sec"
      },
      {
        "type": "range",
        "id": "popup_days",
        "label": "t:sections.newsletter-popup.settings.popup_days.label",
        "default": 30,
        "info": "t:sections.newsletter-popup.settings.popup_days.info",
        "min": 2,
        "max": 30,
        "step": 1,
        "unit": "day"
      },
      {
        "type": "header",
        "content": "t:sections.newsletter-popup.settings.header_content"
      },
      {
        "type": "image_picker",
        "id": "popup_logo",
        "label": "Logo",
        "info": "Transparent PNG. Shown at the top, in its own colours."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "default": 120,
        "min": 60,
        "max": 260,
        "step": 10,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "logo_gap",
        "label": "Space under logo",
        "default": 34,
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "checkbox",
        "id": "logo_rule",
        "label": "Hairline under logo",
        "default": false
      },
      {
        "type": "text",
        "id": "line_small",
        "label": "Line 1, small",
        "default": "Unlock"
      },
      {
        "type": "text",
        "id": "line_big",
        "label": "Line 2, large",
        "default": "£10 off"
      },
      {
        "type": "text",
        "id": "line_sub",
        "label": "Line 3, small",
        "default": "your first case"
      },
      {
        "type": "richtext",
        "id": "popup_text",
        "label": "Paragraph between headline and form",
        "info": "Leave empty for the cleanest hierarchy. Use the fine print below the button instead."
      },
      {
        "type": "header",
        "content": "t:sections.newsletter-popup.settings.header_newsletter"
      },
      {
        "type": "checkbox",
        "id": "enable_newsletter",
        "label": "t:sections.newsletter-popup.settings.enable_newsletter.label",
        "default": true
      },
      {
        "type": "text",
        "id": "input_placeholder",
        "label": "Email field placeholder",
        "default": "Email"
      },
      {
        "type": "text",
        "id": "submit_label",
        "label": "Button label",
        "default": "CLAIM YOUR £10"
      },
      {
        "type": "text",
        "id": "fineprint",
        "label": "Fine print under the button",
        "default": "We email you the code. Cases only. 18+"
      },
      {
        "type": "text",
        "id": "decline_label",
        "label": "Decline link at the bottom",
        "default": "No thanks",
        "info": "Leave empty to show only the X in the corner."
      },
      {
        "type": "header",
        "content": "Side image"
      },
      {
        "type": "image_picker",
        "id": "popup_image",
        "label": "t:sections.newsletter-popup.settings.popup_image.label",
        "info": "t:sections.newsletter-popup.settings.popup_image.info"
      },
      {
        "type": "select",
        "id": "image_position",
        "label": "t:sections.newsletter-popup.settings.image_position.label",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "t:sections.newsletter-popup.settings.image_position.options.left.label"
          },
          {
            "value": "right",
            "label": "t:sections.newsletter-popup.settings.image_position.options.right.label"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_social_icons",
        "label": "Show social icons",
        "default": false
      },
      {
        "type": "header",
        "content": "t:sections.newsletter-popup.settings.header_button"
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "t:sections.newsletter-popup.settings.button_label.label"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "t:sections.newsletter-popup.settings.button_link.label"
      }
    ],
    "blocks": [
      {
        "type": "header",
        "name": "t:sections.newsletter-popup.blocks.header.name",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "reminder_label",
            "label": "t:sections.newsletter-popup.blocks.header.settings.text.label",
            "default": "Get 10% off",
            "info": "t:sections.newsletter-popup.blocks.header.settings.text.info"
          }
        ]
      }
    ],
    "default": {
      "settings": {},
      "blocks": [
        {
          "type": "header",
          "settings": {}
        }
      ]
    },
    "disabled_on": {
      "groups": ["footer", "header"]
    }
  }
{% endschema %}
