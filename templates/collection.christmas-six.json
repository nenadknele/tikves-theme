/*
 * The Christmas Six page, 3 Nov 2026. The festive Barovo photograph above the
 * normal collection header: wide crop on desktop, phone crop on the phone.
 * Used only by /collections/the-christmas-six. Remove after 16 Dec.
 */
{
  "sections": {
    "festive-hero": {
      "type": "tikves-hero",
      "settings": {
        "image": "shopify://shop_images/barovo-hero-desktop-169.jpg",
        "image_mobile": "shopify://shop_images/barovo-hero-phone-tight.jpg",
        "lcp": true,
        "focal_desktop": "center bottom",
        "focal_mobile": "center center",
        "heading": "",
        "subheading": "",
        "button_label": "",
        "heading_tag": "h2",
        "text_panel": false,
        "stack_mobile": false,
        "scrim": 0,
        "height_mobile": 340,
        "ratio_desktop": "fixed",
        "height_desktop": 520
      }
    },
    "collection-header": {
      "type": "collection-header",
      "settings": {
        "enable": true,
        "collection_image_enable": false,
        "parallax": true,
        "parallax_direction": "top"
      }
    },
    "main-collection": {
      "type": "main-collection",
      "blocks": {
        "collection_description": {
          "type": "collection_description",
          "settings": {}
        },
        "subcollections": {
          "type": "subcollections",
          "settings": {
            "subcollections_per_row": 5
          }
        },
        "product_grid": {
          "type": "product_grid",
          "settings": {
            "enable_collection_count": true,
            "per_row": 4,
            "rows_per_page": 10,
            "mobile_flush_grid": true
          }
        }
      },
      "block_order": [
        "collection_description",
        "subcollections",
        "product_grid"
      ],
      "settings": {
        "enable_sidebar": true,
        "collapsed": true,
        "filter_style": "drawer",
        "enable_color_swatches": true,
        "enable_swatch_labels": true,
        "enable_sort": true
      }
    }
  },
  "order": [
    "festive-hero",
    "collection-header",
    "main-collection"
  ]
}
