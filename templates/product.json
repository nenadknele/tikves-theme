{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "top_line": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.custom.top_line.value }}"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "bb_glance": {
          "type": "custom",
          "settings": {
            "code": "{% comment %} At-a-glance strip on spirits, cases and sets, 11 Nov 2026. Prints custom.glance word for word, and nothing when it is empty. Logic lives in snippets/tl-buybox.liquid. {% endcomment %}{% render 'tl-buybox', product: product, part: 'glance' %}"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "variant_labels": true,
            "picker_type": "button",
            "color_swatches": false
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "surface_pickup_enable": false,
            "show_gift_card_recipient": true
          }
        },
        "rarity": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.custom.rarity_note.value }}"
          }
        },
        "back_in_stock": {
          "type": "custom",
          "settings": {
            "code": "{% comment %} Back in stock capture, 27 Aug 2026. All logic and copy live in snippets/tikves-back-in-stock.liquid. Renders only when the product is sold out and belongs to a group with a Klaviyo list behind it: tag Rakija or vendor Chateau de Gourdon. Do not duplicate the code here. {% endcomment %}{% render 'tikves-back-in-stock', product: product %}"
          }
        },
        "separator-1": {
          "type": "separator",
          "settings": {}
        },
        "description": {
          "type": "description",
          "settings": {
            "is_tab": false
          }
        },
        "bb_bf": {
          "type": "custom",
          "settings": {
            "code": "{% comment %} Buy box test, 7 Nov 2026. Logic and words live in snippets/tl-buybox.liquid. {% endcomment %}{% render 'tl-buybox', product: product, part: 'bf' %}"
          }
        },
        "bb_faq": {
          "type": "custom",
          "settings": {
            "code": "{% comment %} Buy box test, 7 Nov 2026. Logic and words live in snippets/tl-buybox.liquid. {% endcomment %}{% render 'tl-buybox', product: product, part: 'faq' %}"
          }
        },
        "bb_sticky": {
          "type": "custom",
          "settings": {
            "code": "{% comment %} Buy box test, 7 Nov 2026. Logic and words live in snippets/tl-buybox.liquid. {% endcomment %}{% render 'tl-buybox', product: product, part: 'sticky' %}"
          }
        },
        "bb_assure": {
          "type": "custom",
          "settings": {
            "code": "{% comment %} Buy box tidy, 12 Nov 2026. Stock, delivery, dates, guarantee, secure checkout and the finder line as one list. Logic and words live in snippets/tl-buybox.liquid. {% endcomment %}{% render 'tl-buybox', product: product, part: 'assure' %}"
          }
        }
      },
      "block_order": [
        "top_line",
        "price",
        "bb_glance",
        "bb_bf",
        "variant_picker",
        "buy_buttons",
        "back_in_stock",
        "bb_assure",
        "rarity",
        "separator-1",
        "description",
        "bb_faq",
        "bb_sticky"
      ],
      "settings": {
        "sku_enable": false,
        "image_position": "left",
        "image_size": "medium",
        "product_zoom_enable": true,
        "thumbnail_position": "below",
        "thumbnail_height": "flexible",
        "thumbnail_arrows": true,
        "mobile_layout": "full",
        "enable_video_looping": true,
        "product_video_style": "muted"
      }
    },
    "product-recommendations": {
      "type": "product-recommendations",
      "settings": {
        "product_recommendations_heading": "You may also like",
        "related_count": 4,
        "products_per_row": 4
      }
    },
    "recently-viewed": {
      "type": "recently-viewed",
      "settings": {
        "recent_count": 5
      }
    },
    "collection-return": {
      "type": "collection-return",
      "settings": {}
    },
    "sub": {
      "type": "product-full-width",
      "disabled": true,
      "settings": {}
    }
  },
  "order": [
    "main",
    "sub",
    "product-recommendations",
    "recently-viewed",
    "collection-return"
  ]
}
