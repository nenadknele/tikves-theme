{%- comment -%}
  Early bird pages and homepage band, 9 Nov 2026. The shared look, from the
  design of 9 November and 08 · DESIGN v4: Paper, Paper Deep, Ink, Wine
  (chrome and accent, Cream text on it), Vine, Terra Rossa (the one button
  on a screen, never on a dark ground), Stone (borders only). Headings in
  the theme's heading font (Fraunces), body in the theme's body font
  (Inter). The italic heading words use Fraunces Regular Italic, loaded here
  once a page. Rendered by sections/tl-early-bird-band, tl-early-bird and
  tl-early-bird-thanks.
{%- endcomment -%}
{%- unless tl_eb_style_done -%}
  {%- assign tl_eb_style_done = true -%}
  {%- assign tl_eb_italic = settings.type_header_font_family | font_modify: 'weight', '400' | font_modify: 'style', 'italic' -%}
  {%- style -%}
    {%- if tl_eb_italic -%}{{ tl_eb_italic | font_face: font_display: 'swap' }}{%- endif -%}
    .tl-eb-x {
      --eb-paper: #F5EFE7;
      --eb-paper-deep: #EAE3D9;
      --eb-ink: #1F2328;
      --eb-wine: #4A0D18;
      --eb-vine: #3A4A38;
      --eb-terra: #A64029;
      --eb-stone: #B9AC9B;
      /* The one button colour on the early bird pages and band, the red of the watercolour flowers, his pick of 9 Nov 2026. One edit to change it. */
      --eb-cta: #B5161B;
      --eb-cta-hover: #8E1015;
      --eb-head: {{ settings.type_header_font_family.family }}, {{ settings.type_header_font_family.fallback_families }};
      --eb-body: {{ settings.type_base_font_family.family }}, {{ settings.type_base_font_family.fallback_families }};
      color: var(--eb-ink);
      font-family: var(--eb-body);
    }
    .tl-eb-x h1, .tl-eb-x h2, .tl-eb-x h3, .tl-eb-x p { text-transform: none; letter-spacing: 0; }
    .tl-eb-x .eb-h { font-family: var(--eb-head); font-weight: 600; margin: 0; }
    .tl-eb-x .eb-em { font-style: italic; font-weight: 400; }
    .tl-eb-x .eb-btn {
      display: block; width: 100%; box-sizing: border-box; min-height: 52px;
      padding: 16px 20px; text-align: center; text-decoration: none;
      font-family: var(--eb-body); font-size: 16px; font-weight: 500; line-height: 1.25;
      letter-spacing: 0; text-transform: none; border-radius: 0;
    }
    .tl-eb-x .eb-btn--solid { background: var(--eb-cta); color: #FFFFFF; border: 1px solid var(--eb-cta); border-radius: 999px; }
    .tl-eb-x .eb-btn--solid:hover { background: var(--eb-cta-hover); border-color: var(--eb-cta-hover); color: #FFFFFF; }
    .tl-eb-x .eb-btn--line { border-radius: 999px; }
    .tl-eb-x .eb-btn--line { background: transparent; color: var(--eb-ink); border: 1px solid var(--eb-ink); }
    .tl-eb-x .eb-btn--line:hover { background: var(--eb-ink); color: var(--eb-paper); }
    .tl-eb-x .eb-btn:focus-visible { outline: 2px solid var(--eb-ink); outline-offset: 3px; }
    /* Words that change from Fri 20 to Mon 23 Nov: html.tl-eb-open is set in the head by snippets/tl-dates. */
    .tl-eb-x .eb-open { display: none; }
    html.tl-eb-open .tl-eb-x .eb-open { display: inline; }
    html.tl-eb-open .tl-eb-x .eb-pre { display: none; }
    .tl-eb-x .eb-strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .tl-eb-x .eb-strip a, .tl-eb-x .eb-grid a { display: block; }
    .tl-eb-x .eb-sq { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; background: var(--eb-paper-deep); }
    /* Polaroids, snippets/tl-eb-polaroids */
    .tl-eb-x .eb-pol { background: var(--eb-paper-deep); padding: 48px 16px 64px; border-top: 1px solid var(--eb-stone); }
    .tl-eb-x .eb-pol__head { font-size: 30px; font-weight: 400; font-style: italic; text-align: center; margin: 0 0 32px; }
    .tl-eb-x .eb-pol__grid { list-style: none; margin: 0 auto; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 18px 14px; max-width: 1180px; }
    .tl-eb-x .eb-pol__item { margin: 0; width: calc(50% - 7px); max-width: 260px; }
    .tl-eb-x .eb-pol__card { display: block; background: #FFFFFF; padding: 10px 10px 0; box-shadow: 0 6px 18px rgba(31, 35, 40, 0.18); text-decoration: none; color: var(--eb-ink); transition: transform 0.2s ease; }
    .tl-eb-x .eb-pol__img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; background: var(--eb-paper); }
    .tl-eb-x .eb-pol__cap { display: block; padding: 10px 2px 14px; font-family: var(--eb-head); font-style: italic; font-size: 16px; line-height: 1.3; text-align: center; }
    .tl-eb-x .eb-pol__item--1 .eb-pol__card { transform: rotate(-3deg); }
    .tl-eb-x .eb-pol__item--2 .eb-pol__card { transform: rotate(2.5deg) translateY(10px); }
    .tl-eb-x .eb-pol__item--3 .eb-pol__card { transform: rotate(-1.5deg); }
    .tl-eb-x .eb-pol__item--4 .eb-pol__card { transform: rotate(3deg) translateY(8px); }
    .tl-eb-x .eb-pol__item--5 .eb-pol__card { transform: rotate(-2.5deg); }
    .tl-eb-x a.eb-pol__card:hover { transform: rotate(0) translateY(-4px); }
    @media (prefers-reduced-motion: reduce) { .tl-eb-x .eb-pol__card { transition: none; } }
    @media (min-width: 769px) {
      .tl-eb-x .eb-pol { padding: 80px 32px 96px; }
      .tl-eb-x .eb-pol__head { font-size: 40px; margin-bottom: 48px; }
      .tl-eb-x .eb-pol__item { width: 210px; }
      .tl-eb-x .eb-pol__grid { gap: 0 26px; }
    }
    @media (min-width: 769px) {
      .tl-eb-x .eb-btn { display: inline-block; width: auto; min-width: 300px; }
      .tl-eb-x .eb-strip { max-width: 1200px; margin: 0 auto; }
    }
  {%- endstyle -%}
{%- endunless -%}
