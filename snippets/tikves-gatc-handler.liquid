{%- comment -%}
  TIKVES LONDON . GRID ADD TO CART HANDLER
  The CSS and the click handler for every data-tk-gatc form: the product
  card buttons in snippets/tikves-grid-add-to-cart.liquid and the home page
  rows in sections/tikves-singles.liquid. Guarded by window.tkGridAtc, so
  rendering it more than once on a page is harmless.

  18 Oct 2026: split out of tikves-grid-add-to-cart. The home page has no
  product cards, so the handler never loaded there and the home Add to cart
  buttons posted the whole page to /cart instead of opening the drawer.
{%- endcomment -%}

<script>
(function () {
  if (window.tkGridAtc) return;
  window.tkGridAtc = true;

  var css = ''
    + '.tk-gatc{margin:10px 0 0;position:relative;z-index:2;text-align:center}'
    + '.tk-gatc__form{margin:0}'
    + '.tk-gatc__btn{display:block;width:86%;max-width:340px;margin:0 auto;box-sizing:border-box;padding:13px 20px;'
    + 'border:1px solid #A64029;border-radius:999px;background:#A64029;color:#FFFFFF;'
    + 'font-size:13px;letter-spacing:.1em;text-transform:uppercase;text-align:center;'
    + 'text-decoration:none;cursor:pointer;line-height:1.3;'
    + 'transition:background-color .15s ease,color .15s ease,border-color .15s ease}'
    + '.tk-gatc__btn:hover{background:#8E3623;border-color:#8E3623;color:#FFFFFF}'
    + '.tk-gatc__btn[disabled]{background:transparent;color:#1F2328;border-color:#B9AC9B;opacity:.7;cursor:default}';
  var st = document.createElement('style');
  st.appendChild(document.createTextNode(css));
  document.head.appendChild(st);

  document.addEventListener('submit', function (e) {
    var form = e.target.closest ? e.target.closest('[data-tk-gatc]') : null;
    if (!form) return;
    e.preventDefault();
    var btn = form.querySelector('button');
    if (!btn || btn.disabled) return;
    var label = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Adding';
    fetch('/cart/add.js', { method: 'POST', headers: { 'Accept': 'application/json' }, body: new FormData(form) })
      .then(function (r) { if (!r.ok) { throw new Error('add failed'); } return r.json(); })
      .then(function () { return fetch('/cart.js', { headers: { 'Accept': 'application/json' } }).then(function (r) { return r.json(); }); })
      .then(function (cart) {
        var num = document.querySelector('.cart-link__bubble-num');
        if (num) { num.textContent = cart.item_count; }
        var bub = document.querySelector('.cart-link__bubble');
        if (bub) { bub.classList.add('cart-link__bubble--visible'); }
        document.dispatchEvent(new CustomEvent('cart:build'));
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: cart } }));
        document.dispatchEvent(new CustomEvent('cart:open'));
        btn.textContent = 'Added';
        setTimeout(function () { btn.disabled = false; btn.textContent = label; }, 2500);
      })
      .catch(function () {
        btn.disabled = false;
        btn.textContent = label;
        form.submit();
      });
  });
})();
</script>
