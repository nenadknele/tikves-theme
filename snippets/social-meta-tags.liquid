{%- comment -%}
  Open Graph and X (Twitter) cards. Oct 2026, SEO pass:
  - images use image_url at 1200px over https, with alt text
  - the description falls back to the product, collection or article text
    when no SEO description is set in admin, cut to about 160 characters
  - og:locale is set, and everything is escaped once
{%- endcomment -%}
{%- liquid
  assign og_title = page_title
  assign og_url = canonical_url
  assign og_type = 'website'
  assign og_image = page_image
  assign og_description = page_description | default: shop.description | default: shop.name

  case request.page_type
    when 'product'
      assign og_title = product.title
      assign og_type = 'product'
      if page_description == blank and product.description != blank
        assign og_description = product.description
      endif
    when 'collection'
      if page_description == blank and collection.description != blank
        assign og_description = collection.description
      endif
    when 'article'
      assign og_title = article.title
      assign og_type = 'article'
      assign og_description = page_description | default: article.excerpt_or_content
      if article.image
        assign og_image = article.image
      endif
    when 'password'
      assign og_title = shop.name
      assign og_url = shop.url
      assign og_description = shop.description | default: shop.name
  endcase

  assign og_title = og_title | strip_html | strip
  assign og_image_alt = og_image.alt | default: og_title | escape
  assign og_image_width = og_image.width | at_most: 1200
  assign og_title = og_title | escape
  assign og_description = og_description | strip_html | strip_newlines | strip | truncatewords: 30 | truncate: 160 | escape
  assign og_locale = request.locale.iso_code | replace: '-', '_'
  if og_locale == 'en'
    assign og_locale = 'en_GB'
  endif

  assign twitter_handle = ''
  if settings.social_twitter_link != blank
    assign twitter_handle = settings.social_twitter_link | split: '?' | first | split: '/' | last | remove: '@' | prepend: '@'
  endif
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description }}">
<meta property="og:locale" content="{{ og_locale }}">
{%- if request.page_type == 'product' %}
<meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
<meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
<meta property="product:availability" content="{% if product.available %}instock{% else %}oos{% endif %}">
{%- endif -%}
{%- if og_image != blank %}
<meta property="og:image" content="https:{{ og_image | image_url: width: og_image_width }}">
<meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: og_image_width }}">
<meta property="og:image:width" content="{{ og_image_width }}">
<meta property="og:image:height" content="{{ og_image_width | divided_by: og_image.aspect_ratio | round }}">
<meta property="og:image:alt" content="{{ og_image_alt }}">
{%- endif -%}
{%- if request.page_type == 'article' %}
<meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">
<meta property="article:modified_time" content="{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">
{%- endif -%}
{%- if twitter_handle != blank and twitter_handle != '@' %}
<meta name="twitter:site" content="{{ twitter_handle | escape }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title }}">
<meta name="twitter:description" content="{{ og_description }}">
{%- if og_image != blank %}
<meta name="twitter:image" content="https:{{ og_image | image_url: width: og_image_width }}">
<meta name="twitter:image:alt" content="{{ og_image_alt }}">
{%- endif -%}
