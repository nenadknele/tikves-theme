{%- comment -%}
  30 Sep 2026, operator: Lucky Orange loads only after a yes to BOTH Analytics
  and Marketing on the cookie banner, as the cookie page says in sections 5
  and 9. This replaces the Lucky Orange app embed, which loaded before any
  choice and ignored a no. Keep that embed OFF while this snippet is in use.
  On a later no, Lucky Orange's cookies and storage are cleared and the page
  reloads, so the script is gone. Rendered by sections/lo-consent-loader.liquid,
  which sits in the footer group.
{%- endcomment -%}
<script>
(function () {
  var SRC = 'https://tools.luckyorange.com/core/lo.js?site-id=c8bbb84e';
  var loaded = false;

  function clearLO() {
    var host = location.hostname;
    ['lo-uid', 'lo-visits'].forEach(function (n) {
      document.cookie = n + '=; Max-Age=0; path=/';
      document.cookie = n + '=; Max-Age=0; path=/; domain=' + host;
      document.cookie = n + '=; Max-Age=0; path=/; domain=.' + host;
    });
    try {
      Object.keys(localStorage).forEach(function (k) {
        if (k.indexOf('lo-') === 0) localStorage.removeItem(k);
      });
      Object.keys(sessionStorage).forEach(function (k) {
        if (k.indexOf('lo-') === 0) sessionStorage.removeItem(k);
      });
    } catch (e) {}
  }

  function load() {
    if (loaded) return;
    loaded = true;
    window.LOQ = window.LOQ || [];
    window.LOQ.push(['ready', function (LO) {
      LO.$internal.ready('privacy').then(function () {
        LO.privacy.setConsentStatus(true);
      });
    }]);
    var s = document.createElement('script');
    s.async = true;
    s.defer = true;
    s.src = SRC;
    document.head.appendChild(s);
  }

  function decide(analytics, marketing) {
    if (analytics === true && marketing === true) {
      load();
    } else {
      clearLO();
      if (loaded) location.reload();
    }
  }

  document.addEventListener('visitorConsentCollected', function (e) {
    var d = e.detail || {};
    decide(d.analyticsAllowed, d.marketingAllowed);
  });

  function check() {
    var cp = window.Shopify && window.Shopify.customerPrivacy;
    if (!cp) return;
    decide(cp.analyticsProcessingAllowed(), cp.marketingAllowed());
  }

  if (window.Shopify && typeof window.Shopify.loadFeatures === 'function') {
    window.Shopify.loadFeatures(
      [{ name: 'consent-tracking-api', version: '0.1' }],
      function (err) { if (!err) check(); }
    );
  }
})();
</script>
