{%- comment -%}
  TIKVES LONDON . PHONE BUY BAR
  Operator ruling 18 Oct 2026: on a phone, once the product page's own Add
  to cart button has scrolled up out of view, a slim bar holds the name,
  the price and Add to cart at the foot of the screen. Phones only;
  desktop keeps its layout.

  The bar's button presses the page's own Add to cart button, so the
  quantity, the cart drawer and the stock check all behave exactly as they
  do on the page. Not rendered for a sold-out product. Hidden while a
  drawer or modal is open.

  Rendered once, from the buy_buttons block in
  snippets/product-template.liquid, on the product template only.
  TO UNDO: delete this snippet and its render line there.
{%- endcomment -%}

{%- if template.name == 'product' and product.available -%}
<div class="tl-buybar" data-tl-buybar data-form-id="{{ form_id }}" aria-hidden="true">
  <div class="tl-buybar__text">
    <span class="tl-buybar__title">{{ product.title | escape }}</span>
    <span class="tl-buybar__price">{{ current_variant.price | money }}</span>
  </div>
  <button type="button" class="tl-buybar__btn" tabindex="-1">{{ 'products.product.add_to_cart' | t }}</button>
</div>

<style>
  .tl-buybar{display:none}
  @media only screen and (max-width: 768px){
    .tl-buybar{
      display:flex;align-items:center;gap:12px;
      position:fixed;left:0;right:0;bottom:0;z-index:25;
      padding:10px 16px calc(10px + env(safe-area-inset-bottom));
      background:#F5EFE7;border-top:1px solid #D9CFC2;
      box-shadow:0 -4px 16px rgba(31,35,40,.08);
      transform:translateY(110%);transition:transform .25s ease;
    }
    html.tl-buybar-on .tl-buybar{transform:translateY(0)}
    html.js-drawer-open .tl-buybar,
    html.modal-open .tl-buybar{transform:translateY(110%)}
    html.tl-buybar-on body{padding-bottom:72px}
    .tl-buybar__text{flex:1;min-width:0;display:flex;flex-direction:column;line-height:1.25;text-align:left}
    .tl-buybar__title{font-size:15px;font-weight:600;color:#1F2328;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .tl-buybar__price{font-size:14px;color:#1F2328}
    .tl-buybar__btn{
      flex:0 0 auto;min-height:44px;padding:0 22px;border:0;border-radius:999px;
      background:#A64029;color:#FFFFFF;font-size:13px;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;
    }
  }
</style>

<script>
(function () {
  if (window.tlBuyBar) return;
  window.tlBuyBar = true;
  var bar = document.querySelector('[data-tl-buybar]');
  if (!bar) return;
  var form = document.getElementById(bar.getAttribute('data-form-id'));
  var main = form ? form.querySelector('[data-add-to-cart]') : null;
  if (!main) { bar.remove(); return; }
  var html = document.documentElement;
  var btn = bar.querySelector('button');

  // Show only once the page's own button has scrolled above the screen.
  // A scroll check rather than an IntersectionObserver: a jump down the
  // page can skip the button without it ever crossing the screen edge.
  var queued = false;
  function check() {
    queued = false;
    var gone = main.getBoundingClientRect().bottom < 0;
    html.classList.toggle('tl-buybar-on', gone);
    bar.setAttribute('aria-hidden', gone ? 'false' : 'true');
    btn.tabIndex = gone ? 0 : -1;
  }
  window.addEventListener('scroll', function () {
    if (queued) return;
    queued = true;
    window.requestAnimationFrame(check);
  }, { passive: true });
  check();

  btn.addEventListener('click', function () {
    if (main.disabled) return;
    main.click();
  });
})();
</script>
{%- endif -%}
