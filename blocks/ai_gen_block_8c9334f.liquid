{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
  }

  .ai-editorial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    align-items: start;
  }

  .ai-editorial-image-wrapper-{{ ai_gen_id }} {
    grid-column: span {{ block.settings.image_columns }};
    position: relative;
  }

  .ai-editorial-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-editorial-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-editorial-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-editorial-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-editorial-content-{{ ai_gen_id }} {
    grid-column: span {{ block.settings.content_columns }};
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-editorial-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: {{ block.settings.category_color }};
    margin: 0;
  }

  .ai-editorial-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    line-height: 1.2;
    color: {{ block.settings.headline_color }};
    margin: 0;
  }

  .ai-editorial-byline-{{ ai_gen_id }} {
    font-size: {{ block.settings.byline_size }}px;
    color: {{ block.settings.byline_color }};
    font-style: italic;
    margin: 0;
  }

  .ai-editorial-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.7;
    color: {{ block.settings.body_color }};
  }

  .ai-editorial-body-{{ ai_gen_id }} p {
    margin: 0 0 1em;
  }

  .ai-editorial-body-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-editorial-cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background-color: {{ block.settings.cta_background }};
    color: {{ block.settings.cta_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.cta_size }}px;
    font-weight: 600;
    border-radius: {{ block.settings.cta_border_radius }}px;
    transition: background-color 0.3s ease;
  }

  .ai-editorial-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-editorial-image-wrapper-{{ ai_gen_id }},
    .ai-editorial-content-{{ ai_gen_id }} {
      grid-column: span 1;
    }

    {% if block.settings.mobile_image_first %}
      .ai-editorial-image-wrapper-{{ ai_gen_id }} {
        order: 1;
      }

      .ai-editorial-content-{{ ai_gen_id }} {
        order: 2;
      }
    {% else %}
      .ai-editorial-content-{{ ai_gen_id }} {
        order: 1;
      }

      .ai-editorial-image-wrapper-{{ ai_gen_id }} {
        order: 2;
      }
    {% endif %}

    .ai-editorial-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.7 }}px;
    }

    .ai-editorial-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<editorial-layout-{{ ai_gen_id }}
  class="ai-editorial-layout-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-editorial-grid-{{ ai_gen_id }}">
    <div class="ai-editorial-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.featured_image %}
        <img
          src="{{ block.settings.featured_image | image_url: width: 1200 }}"
          alt="{{ block.settings.featured_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.featured_image.width }}"
          height="{{ block.settings.featured_image.height }}"
          class="ai-editorial-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-editorial-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-editorial-empty-state-{{ ai_gen_id }}">
            Next, add a featured image
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-editorial-content-{{ ai_gen_id }}">
      {% if block.settings.category != blank %}
        <p class="ai-editorial-category-{{ ai_gen_id }}">{{ block.settings.category }}</p>
      {% endif %}

      {% if block.settings.headline != blank %}
        <h2 class="ai-editorial-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      {% endif %}

      {% if block.settings.byline != blank %}
        <p class="ai-editorial-byline-{{ ai_gen_id }}">{{ block.settings.byline }}</p>
      {% endif %}

      {% if block.settings.body_text != blank %}
        <div class="ai-editorial-body-{{ ai_gen_id }}">
          {{ block.settings.body_text }}
        </div>
      {% endif %}

      {% if block.settings.cta_text != blank and block.settings.cta_link != blank %}
        <a href="{{ block.settings.cta_link }}" class="ai-editorial-cta-{{ ai_gen_id }}">
          {{ block.settings.cta_text }}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</editorial-layout-{{ ai_gen_id }}>

<script>
  (function() {
    class EditorialLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const cta = this.querySelector('.ai-editorial-cta-{{ ai_gen_id }}');
        if (cta) {
          cta.setAttribute('role', 'button');
        }
      }
    }

    customElements.define('editorial-layout-{{ ai_gen_id }}', EditorialLayout{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Magazine editorial",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "image_columns",
      "label": "Image width",
      "min": 4,
      "max": 8,
      "step": 1,
      "unit": "col",
      "default": 6
    },
    {
      "type": "range",
      "id": "content_columns",
      "label": "Content width",
      "min": 4,
      "max": 8,
      "step": 1,
      "unit": "col",
      "default": 6
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Content spacing",
      "min": 12,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F5EFE7"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "category",
      "label": "Category",
      "default": "Wine Stories"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "The Art of Winemaking"
    },
    {
      "type": "text",
      "id": "byline",
      "label": "Byline",
      "default": "By the Tikveš team"
    },
    {
      "type": "richtext",
      "id": "body_text",
