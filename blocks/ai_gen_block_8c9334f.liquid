      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "category_color",
      "label": "Category",
      "default": "#A64029"
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Headline",
      "default": "#1F2328"
    },
    {
      "type": "color",
      "id": "byline_color",
      "label": "Byline",
      "default": "#4A0D18"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text",
      "default": "#1F2328"
    },
    {
      "type": "color",
      "id": "cta_background",
      "label": "Button background",
      "default": "#A64029"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
